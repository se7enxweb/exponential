#!/bin/sh
# Checks the staged files before a commit: PHP syntax, the file manifest
# (share/filelist.md5) and the code style of changed PHP files.
# Enable once with: make hooks   Skip in an emergency with: git commit --no-verify

cd "$(git rev-parse --show-toplevel)" || exit 1
status=0

# PHP syntax of every staged PHP file, as staged
for file in $(git diff --cached --name-only --diff-filter=ACMR -- '*.php'); do
    if ! git show ":$file" | php -l >/dev/null 2>&1; then
        echo "pre-commit: syntax error in $file"
        git show ":$file" | php -l 2>&1 | grep -v '^No syntax errors' | sed 's/^/    /'
        status=1
    fi
done

php bin/php/checkmanifest.php --staged || status=1
php bin/php/checkcodestyle.php --staged || status=1

if [ $status -ne 0 ]; then
    echo "pre-commit: commit refused. Fix the above, or skip the checks with: git commit --no-verify"
fi
exit $status
