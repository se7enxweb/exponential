# Static analysis of Exponential with PHPStan.
#
# phpstan-baseline.neon holds every finding the code had when the check was
# introduced; only new findings fail. Raise the level or shrink the baseline in
# small separate steps.
#
# Run: make phpstan    Regenerate the baseline: make phpstan-baseline

includes:
    - phpstan-baseline.neon

parameters:
    level: 1
    phpVersion: 80100
    paths:
        - kernel
        - lib
    excludePaths:
        - vendor/*
        - var/*
        - */tests/*
        # CLI scripts written as classes that also declare global helper functions;
        # loading two of them in one analysis process redeclares those functions
        - kernel/private/classes/commands/*
        # Its iterator methods lack the PHP 8.1 tentative return types (or a
        # #[\ReturnTypeWillChange] attribute), which PHPStan can not baseline;
        # analyse it again once that is fixed
        - kernel/private/classes/clusterfilehandlers/dfsbackends/dfs_filter_iterator.php
    bootstrapFiles:
        - autoload.php
    tmpDir: .devtools/phpstan
    # a baseline entry the code no longer needs fails the check, so the baseline only shrinks; entries that depend
    # on what is installed (the MongoDB library, which CI does not install) say reportUnmatched: false
    reportUnmatchedIgnoredErrors: true
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # expqueue is an extension: its classes exist only where it is active. Where it is installed (as in CI) these
        # errors do not occur, so the entry may match nothing
        -
            message: '#expQueue#'
            paths:
                - kernel/classes/migration/expmigrationjob.php
                - kernel/classes/migration/expmigrationqueuehandler.php
                - kernel/classes/transfer/expkerneltransferqueuehandler.php
            reportUnmatched: false
