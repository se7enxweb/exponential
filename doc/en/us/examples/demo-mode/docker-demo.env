# Exponential 6: environment file for a public demo container
#
# Free documentation: GFDL 1.3 or later, see doc/en/us/README-LICENSE.md.
#
# Use it for the demo service only:
#   docker run --env-file docker-demo.env ...
# or in compose.yaml, under the demo service:
#   env_file: docker-demo.env
# With PHP-FPM in the container, the pool must pass the environment on
# (clear_env = no) or carry env[EXP_DEMO_MODE] = 1 itself
# (php-fpm-pool-demo.conf). Never put it into a base image other sites use.
# Guide: doc/en/us/bc/6.0/demo-mode.md.

# demo mode: administrator passwords cannot be changed or reset, the installers
# accept the published demo password; only the exact value 1 counts
EXP_DEMO_MODE=1
