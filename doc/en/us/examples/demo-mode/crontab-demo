# Exponential 6: the crontab of a public demo's system user
#
# Free documentation: GFDL 1.3 or later, see doc/en/us/README-LICENSE.md.
#
# Install with "crontab -u demo crontab-demo" (replace demo and the paths).
# The first line gives every job demo mode, so the cronjobs and the scheduled
# rebuild run with EXP_DEMO_MODE=1 like the web server. Guide:
# doc/en/us/bc/6.0/demo-mode.md; the cronjob groups: doc/en/us/guides/cronjobs.md.

EXP_DEMO_MODE=1
PATH=/usr/local/bin:/usr/bin:/bin

# the kernel's cronjobs, as the shipped exponential.cron runs them
35 6 * * *          cd /var/www/demo.example.com && php runcronjobs.php -q 2>&1
20 5 * * 1          cd /var/www/demo.example.com && php runcronjobs.php -q infrequent 2>&1
0,15,30,45 * * * *  cd /var/www/demo.example.com && php runcronjobs.php -q frequent 2>&1

# rebuild the demo from the current code every two hours (install-demo-sqlite.sh in this folder)
15 */2 * * * /var/www/demo.example.com-builds/install-demo-sqlite.sh >> /var/www/demo.example.com-builds/install.log 2>&1
