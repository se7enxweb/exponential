{* DO NOT EDIT THIS FILE! Use an override template instead. *}
{* The search page of the administration (content/search), which also takes in the former advanced search
   (content/advancedsearch shows this page; its parameters are read as well).

   One GET form: the words at the top, the filter bar beside the results (above them on a narrow screen), the active
   filters as chips that each link to the same search without them, the sort order, the result table and the pages.
   Everything works without javascript; page/content_search_filters.js only keeps Apply disabled until a filter
   changed, shows the from/to dates for a custom range only, sorts on change and adds "Show more".

   fetch( 'content', 'filtered_search' ) (expContentSearchFilters) reads the filters from the request, checks them
   and searches with eZ Find when it is the search engine, else with the built-in engine. A filter the engine cannot
   apply (modification date, owner, language, any of the words, relevance) is not shown ($capabilities).
   One file for every admin design, in design/standard (admin4 needs no other admin design).
   Guide: doc/eng-us/help/searching.md *}
{def $page = fetch( 'content', 'filtered_search', hash( 'offset', first_set( $view_parameters.offset, 0 ) ) )
     $f = $page.filters
     $capabilities = $page.capabilities
     $search_query = $page.query
     $search_has_text = $f.text|trim|ne( '' )
     $date_fields = array()
     $period_names = hash( 'day', 'Last day'|i18n( 'design/admin/content/search' ),
                           'week', 'Last 7 days'|i18n( 'design/admin/content/search' ),
                           'month', 'Last month'|i18n( 'design/admin/content/search' ),
                           'year', 'Last year'|i18n( 'design/admin/content/search' ),
                           'custom', 'Custom range'|i18n( 'design/admin/content/search' ) )
     $mode_names = hash( 'all', 'All words'|i18n( 'design/admin/content/search' ),
                         'any', 'Any word'|i18n( 'design/admin/content/search' ),
                         'phrase', 'Exact phrase'|i18n( 'design/admin/content/search' ) )
     $sort_names = hash( 'relevance', 'Relevance'|i18n( 'design/admin/content/search' ),
                         'name_asc', 'Name A–Z'|i18n( 'design/admin/content/search' ),
                         'name_desc', 'Name Z–A'|i18n( 'design/admin/content/search' ),
                         'modified_desc', 'Modified, newest first'|i18n( 'design/admin/content/search' ),
                         'modified_asc', 'Modified, oldest first'|i18n( 'design/admin/content/search' ),
                         'published_desc', 'Published, newest first'|i18n( 'design/admin/content/search' ),
                         'published_asc', 'Published, oldest first'|i18n( 'design/admin/content/search' ) )}
{if $capabilities.modified}{set $date_fields = $date_fields|append( hash( 'name', 'Modified', 'key', 'modified', 'label', 'Modified'|i18n( 'design/admin/content/search' ) ) )}{/if}
{set $date_fields = $date_fields|append( hash( 'name', 'Published', 'key', 'published', 'label', 'Published'|i18n( 'design/admin/content/search' ) ) )}
{* the search's statistics (site.ini LogSearchStats) count what this page searched *}
{if is_set( $search_data )}{set search_data = $page.search_data}{/if}

<div class="context-block a4-page a4-search" id="search-page">
{* DESIGN: Header START *}<div class="box-header"><div class="box-ml">
<h1 class="context-title">{'Search'|i18n( 'design/admin/content/search' )}</h1>
{* DESIGN: Mainline *}<div class="header-mainline"></div>
{* DESIGN: Header END *}</div></div>

{* DESIGN: Content START *}<div class="box-bc"><div class="box-ml"><div class="box-content">

<form class="a4-search-form" id="search-form" action={'/content/search/'|ezurl} method="post" role="search" aria-label="{'Search'|i18n( 'design/admin/content/search' )|wash}" data-search-filters="">

<div class="a4-field a4-search-query">
    <label for="Search">{'Search for'|i18n( 'design/admin/content/search' )}</label>
    <div class="a4-searchrow">
        <input type="search" name="SearchText" id="Search" value="{$f.text|wash}" maxlength="1024" />
        <button type="submit" class="a4-btn a4-btn-primary" name="SearchButton">{'Search'|i18n( 'design/admin/content/search' )}</button>
    </div>
</div>

<div class="a4-search-columns">

{* ---- Filters ---- *}
<aside class="a4-search-filters" id="search-filters" aria-labelledby="search-filters-title">
<div class="a4-search-filters-head">
    <h2 id="search-filters-title"><span class="a4-icon a4-bi-sliders" aria-hidden="true"></span> {'Filters'|i18n( 'design/admin/content/search' )}</h2>
    {* on a narrow page the script folds the bar under this button (the chips above the results show what is set) *}
    <button type="button" class="a4-btn a4-btn-small a4-search-filters-toggle exp-js-only" hidden="hidden" aria-expanded="true" data-search-toggle="" data-text-show="{'Show filters'|i18n( 'design/admin/content/search' )|wash}" data-text-hide="{'Hide filters'|i18n( 'design/admin/content/search' )|wash}">{'Hide filters'|i18n( 'design/admin/content/search' )}</button>
    <div class="a4-actions">
        {if $page.has_filters}<a class="a4-btn a4-btn-small" href={concat( '/content/search', $search_has_text|choose( '', concat( '/(text)/', $f.text|view_parameter ) ) )|ezurl}>{'Reset'|i18n( 'design/admin/content/search' )}</a>{/if}
        <button type="submit" class="a4-btn a4-btn-small a4-btn-primary" data-search-apply="">{'Apply'|i18n( 'design/admin/content/search' )}</button>
    </div>
</div>

{* how the words are searched *}
{if $capabilities.modes|count|gt( 1 )}
<fieldset class="a4-field a4-search-filter">
    <legend>{'Words'|i18n( 'design/admin/content/search' )}</legend>
    {foreach $capabilities.modes as $mode}
    <label class="a4-check"><input type="radio" name="SearchMode" value="{$mode|wash}"{if eq( $mode, $f.mode )} checked="checked"{/if} /> <span>{$mode_names[$mode]|wash}</span></label>
    {/foreach}
</fieldset>
{/if}

{* content classes, by class group; the counts are eZ Find's facets of this search *}
<fieldset class="a4-field a4-search-filter a4-search-classes">
    <legend>{'Content type'|i18n( 'design/admin/content/search' )}</legend>
    {foreach $page.class_groups as $group}
    <div class="a4-search-group" role="group" aria-labelledby="search-class-group-{$group.id}">
        <p class="a4-search-group-name" id="search-class-group-{$group.id}">{if $group.name|ne( '' )}{$group.name|wash}{else}{'Other'|i18n( 'design/admin/content/search' )}{/if}</p>
        <ul class="a4-plain">
        {foreach $group.classes as $class}{if $class.more|not}
            <li><label class="a4-check"><input type="checkbox" name="ClassID[]" value="{$class.id}"{if $class.selected} checked="checked"{/if} /> <span>{$class.name|wash}</span>{if $class.count|is_null|not} <span class="a4-search-count">{$class.count}</span>{/if}</label></li>
        {/if}{/foreach}
        </ul>
        {if $group.more|gt( 0 )}
        <details class="a4-search-more">
            <summary>{'Show more (%count)'|i18n( 'design/admin/content/search',, hash( '%count', $group.more ) )}</summary>
            <ul class="a4-plain">
            {foreach $group.classes as $class}{if $class.more}
                <li><label class="a4-check"><input type="checkbox" name="ClassID[]" value="{$class.id}"{if $class.selected} checked="checked"{/if} /> <span>{$class.name|wash}</span>{if $class.count|is_null|not} <span class="a4-search-count">{$class.count}</span>{/if}</label></li>
            {/if}{/foreach}
            </ul>
        </details>
        {/if}
    </div>
    {/foreach}
</fieldset>

{* the attribute of the one class chosen (the former advanced search's "Class attribute") *}
{if $page.class_attributes}
<div class="a4-field a4-search-filter">
    <label for="search-class-attribute">{'Class attribute'|i18n( 'design/admin/content/search' )}</label>
    <select id="search-class-attribute" name="ClassAttributeID">
        <option value="">{'Any attribute'|i18n( 'design/admin/content/search' )}</option>
        {foreach $page.class_attributes as $attribute}
        <option value="{$attribute.id}"{if $attribute.selected} selected="selected"{/if}>{$attribute.name|wash}</option>
        {/foreach}
    </select>
</div>
{elseif $f.class_ids|count|eq( 1 )|not}
<p class="a4-help a4-search-filter">{'Choose one content type to search in one of its attributes.'|i18n( 'design/admin/content/search' )}</p>
{/if}

{* sections *}
{if $page.sections}
<fieldset class="a4-field a4-search-filter">
    <legend>{'Section'|i18n( 'design/admin/content/search' )}</legend>
    <ul class="a4-plain">
    {foreach $page.sections as $section}
        <li><label class="a4-check"><input type="checkbox" name="SectionID[]" value="{$section.id}"{if $section.selected} checked="checked"{/if} /> <span>{$section.name|wash}</span>{if $section.count|is_null|not} <span class="a4-search-count">{$section.count}</span>{/if}</label></li>
    {/foreach}
    </ul>
</fieldset>
{/if}

{* modified (eZ Find only) and published: a period, or a range of days *}
{foreach $date_fields as $date_field}
{def $range = $f[$date_field.key]}
<fieldset class="a4-field a4-search-filter a4-search-dates" data-search-dates="">
    <legend>{$date_field.label|wash}</legend>
    <label class="a4-sr-only" for="search-{$date_field.key}">{$date_field.label|wash}</label>
    <select id="search-{$date_field.key}" name="{$date_field.name}" data-search-period="">
        <option value="">{'Any time'|i18n( 'design/admin/content/search' )}</option>
        {foreach $period_names as $period => $period_name}
        <option value="{$period}"{if eq( $period, $range.period )} selected="selected"{/if}>{$period_name|wash}</option>
        {/foreach}
    </select>
    <div class="a4-search-range" data-search-range="">
        <label for="search-{$date_field.key}-from">{'From'|i18n( 'design/admin/content/search' )}</label>
        <input type="date" id="search-{$date_field.key}-from" name="{$date_field.name}From" value="{if eq( $range.period, 'custom' )}{$range.from|wash}{/if}" />
        <label for="search-{$date_field.key}-to">{'To'|i18n( 'design/admin/content/search' )}</label>
        <input type="date" id="search-{$date_field.key}-to" name="{$date_field.name}To" value="{if eq( $range.period, 'custom' )}{$range.to|wash}{/if}" />
    </div>
    {if $page.rejected|contains( concat( $date_field.name, 'From' ) )}<p class="a4-field-error">{'The from date is not a valid date.'|i18n( 'design/admin/content/search' )}</p>{/if}
    {if $page.rejected|contains( concat( $date_field.name, 'To' ) )}<p class="a4-field-error">{'The to date is not a valid date.'|i18n( 'design/admin/content/search' )}</p>{/if}
</fieldset>
{undef $range}
{/foreach}

{* the owner: a user's ID, login or e-mail address *}
{if $capabilities.owner}
<div class="a4-field a4-search-filter">
    <label for="search-owner">{'Owner'|i18n( 'design/admin/content/search' )}</label>
    <input type="text" id="search-owner" name="Owner" value="{$f.owner.input|wash}" autocomplete="off" spellcheck="false" aria-describedby="search-owner-help" />
    <span class="a4-help" id="search-owner-help">{'User ID, login or e-mail address.'|i18n( 'design/admin/content/search' )}</span>
    {if $page.rejected|contains( 'Owner' )}<p class="a4-field-error" role="alert">{'No user was found for “%input”.'|i18n( 'design/admin/content/search',, hash( '%input', $f.owner.input ) )|wash}</p>{/if}
</div>
{/if}

{* the language of the translation found *}
{if and( $capabilities.language, $page.languages|count|gt( 1 ) )}
<div class="a4-field a4-search-filter">
    <label for="search-language">{'Language'|i18n( 'design/admin/content/search' )}</label>
    <select id="search-language" name="Language">
        <option value="">{'Any language'|i18n( 'design/admin/content/search' )}</option>
        {foreach $page.languages as $language}
        <option value="{$language.locale|wash}"{if $language.selected} selected="selected"{/if}>{$language.name|wash}{if $language.count|is_null|not} ({$language.count}){/if}</option>
        {/foreach}
    </select>
</div>
{/if}

{* where: everywhere, or the locations the search came with (the header's "this location") *}
{if $page.subtrees}
<fieldset class="a4-field a4-search-filter">
    <legend>{'Location'|i18n( 'design/admin/content/search' )}</legend>
    <label class="a4-check"><input type="radio" name="SubTreeArray[]" value="1" /> <span>{'All content'|i18n( 'design/admin/content/search' )}</span></label>
    {if $page.subtrees|count|eq( 1 )}
    <label class="a4-check"><input type="radio" name="SubTreeArray[]" value="{$page.subtrees.0.node_id}" checked="checked" /> <span>{$page.subtrees.0.path|wash}</span></label>
    {else}
    {* more than one location: kept as they are (a radio could choose only one of them) *}
    {foreach $page.subtrees as $subtree}<input type="hidden" name="SubTreeArray[]" value="{$subtree.node_id}" />{/foreach}
    <p class="a4-help">{'%count locations'|i18n( 'design/admin/content/search',, hash( '%count', $page.subtrees|count ) )}</p>
    {/if}
</fieldset>
{/if}

<div class="a4-field a4-search-filter">
    <label for="search-page-limit">{'Results per page'|i18n( 'design/admin/content/search' )}</label>
    <select id="search-page-limit" name="SearchPageLimit">
        {foreach $page.page_limits as $index => $size}
        {if or( $size|le( ezini( 'SearchSettings', 'MaximumSearchLimit' ) ), eq( $index, 1 ) )}
        <option value="{$index}"{if eq( $index, $f.page_limit )} selected="selected"{/if}>{$size}</option>
        {/if}
        {/foreach}
    </select>
</div>

<div class="a4-actions a4-search-filters-foot">
    <button type="submit" class="a4-btn a4-btn-primary" data-search-apply="">{'Apply'|i18n( 'design/admin/content/search' )}</button>
    {if $page.has_filters}<a class="a4-btn" href={concat( '/content/search', $search_has_text|choose( '', concat( '/(text)/', $f.text|view_parameter ) ) )|ezurl}>{'Reset'|i18n( 'design/admin/content/search' )}</a>{/if}
</div>
</aside>

{* ---- Results ---- *}
<section class="a4-search-main" aria-labelledby="search-results-title">

{if or( $f.text_shortened, $page.text_shortened )}
<p class="a4-notice is-info" role="status">{'The search text was too long and was shortened.'|i18n( 'design/admin/content/search' )}</p>
{/if}

{* the result header: the words and the count, the active filters, the sort order *}
<div class="a4-search-head">
    <h2 id="search-results-title">{if $page.requested|not}{'Search'|i18n( 'design/admin/content/search' )}{elseif $search_has_text}{'Results for “%text” (%count)'|i18n( 'design/admin/content/search',, hash( '%text', $f.text, '%count', $page.count ) )|wash}{else}{'Results (%count)'|i18n( 'design/admin/content/search',, hash( '%count', $page.count ) )|wash}{/if}</h2>
    {if and( $page.requested, $page.count|gt( 0 ) )}
    <div class="a4-search-sort">
        <label for="search-sort">{'Sort by'|i18n( 'design/admin/content/search' )}</label>
        <select id="search-sort" name="SortBy" form="search-form" data-search-sort="">
            {foreach $page.sorts as $sort}
            <option value="{$sort}"{if eq( $sort, $f.sort )} selected="selected"{/if}>{$sort_names[$sort]|wash}</option>
            {/foreach}
        </select>
        <button type="submit" class="a4-btn a4-btn-small" data-search-sort-button="">{'Sort'|i18n( 'design/admin/content/search' )}</button>
    </div>
    {else}
    <input type="hidden" name="SortBy" value="{$f.sort|wash}" />
    {/if}
</div>

{if $page.chips}
<ul class="a4-plain a4-search-chips" aria-label="{'Active filters'|i18n( 'design/admin/content/search' )|wash}">
{foreach $page.chips as $chip}
    {def $chip_name = ''
         $chip_value = $chip.label}
    {switch match=$chip.type}
    {case match='mode'}{set $chip_name = 'Words'|i18n( 'design/admin/content/search' ) $chip_value = $mode_names[$chip.value]}{/case}
    {case match='class'}{set $chip_name = 'Content type'|i18n( 'design/admin/content/search' )}{/case}
    {case match='class_attribute'}{set $chip_name = 'Class attribute'|i18n( 'design/admin/content/search' )}{/case}
    {case match='section'}{set $chip_name = 'Section'|i18n( 'design/admin/content/search' )}{/case}
    {case match='modified'}{set $chip_name = 'Modified'|i18n( 'design/admin/content/search' )}{if ne( $chip.value, 'custom' )}{set $chip_value = $period_names[$chip.value]}{/if}{/case}
    {case match='published'}{set $chip_name = 'Published'|i18n( 'design/admin/content/search' )}{if ne( $chip.value, 'custom' )}{set $chip_value = $period_names[$chip.value]}{/if}{/case}
    {case match='owner'}{set $chip_name = 'Owner'|i18n( 'design/admin/content/search' )}{/case}
    {case match='language'}{set $chip_name = 'Language'|i18n( 'design/admin/content/search' )}{/case}
    {case match='subtree'}{set $chip_name = 'Location'|i18n( 'design/admin/content/search' )}{/case}
    {case}{/case}
    {/switch}
    <li><a class="a4-tag a4-search-chip" href={concat( '/content/search', $chip.query )|ezurl} title="{'Remove this filter'|i18n( 'design/admin/content/search' )|wash}"><span>{$chip_name|wash}: <bdi>{$chip_value|wash}</bdi></span><span class="a4-icon a4-bi-x-lg" role="img" aria-label="{'Remove this filter'|i18n( 'design/admin/content/search' )|wash}"></span></a></li>
    {undef $chip_name $chip_value}
{/foreach}
</ul>
{/if}

{* eZ Find's spelling suggestion: the same search with the suggested words *}
{if $page.spellcheck}
{* the help search's "Did you mean:" (kernel/exphelp), translated in every catalogue *}
<p class="a4-notice is-info">{'Did you mean:'|i18n( 'kernel/exphelp' )} <a href={concat( '/content/search', $page.spellcheck.query )|ezurl}>{$page.spellcheck.text|wash}</a></p>
{/if}

{* Excluded words *}
{if $page.stop_words}
<p class="a4-help">{'The following words were excluded from the search'|i18n( 'design/admin/content/search' )}: {foreach $page.stop_words as $stop_word}{$stop_word.word|wash}{delimiter}, {/delimiter}{/foreach}</p>
{/if}

{* Nothing searched for yet, a search that failed, or no matches *}
{if $page.failed}
<div class="a4-notice is-bad" role="alert"><p>{'The search could not be run. Try fewer or simpler words, or search again later.'|i18n( 'design/admin/content/search' )}</p></div>
{elseif $page.requested|not}
<div class="a4-search-empty">
    <p>{'Type the words to search for.'|i18n( 'design/admin/content/search' )}</p>
    <p class="a4-help">{if $capabilities.empty_search}{'Or choose filters and apply them to list the content they match.'|i18n( 'design/admin/content/search' )}{else}{'The filters narrow the search down once you have typed words.'|i18n( 'design/admin/content/search' )}{/if}</p>
</div>
{elseif $page.count|not}
<div class="a4-search-empty">
    <p><strong>{if $search_has_text}{'No results were found for “%text”.'|i18n( 'design/admin/content/search',, hash( '%text', $f.text ) )|wash}{else}{'No results were found.'|i18n( 'design/admin/content/search' )}{/if}</strong></p>
    <p>{'Search tips'|i18n( 'design/admin/content/search' )}</p>
    <ul>
        <li>{'Check spelling of keywords.'|i18n( 'design/admin/content/search' )}</li>
        <li>{'Try changing some keywords e.g. &quot;car&quot; instead of &quot;cars&quot;.'|i18n( 'design/admin/content/search' )}</li>
        <li>{'Try more general keywords.'|i18n( 'design/admin/content/search' )}</li>
        <li>{'Fewer keywords result in more matches. Try reducing keywords until you get a result.'|i18n( 'design/admin/content/search' )}</li>
        {if $page.chips}<li>{'Remove a filter above.'|i18n( 'design/admin/content/search' )}</li>{/if}
    </ul>
</div>
{elseif $page.result|not}
{* A page past the last one ((offset) beyond the matches, an old link or a list that shrank) *}
<p class="a4-notice is-info" role="status">{'There are no matches on this page.'|i18n( 'design/admin/content/search' )} <a href={concat( '/content/search', $search_query )|ezurl}>{'Go to the first page'|i18n( 'design/admin/content/search' )}</a></p>
{else}
{include name=Result uri='design:content/searchresult.tpl' search_result=$page.result search_text=$f.text}
<div class="a4-listfoot">
<div class="a4-pager">
{include name=Navigator
         uri='design:navigator/google.tpl'
         page_uri='/content/search'
         page_uri_suffix=$search_query
         item_count=$page.count
         view_parameters=hash( 'offset', $page.offset )
         item_limit=$f.limit}
</div>
</div>
{/if}

</section>
</div>
</form>

{* Import and export tools that match the search words (the transfer registry, transfer/search_suggestions.tpl) *}
{include uri='design:transfer/search_suggestions.tpl' query=$f.text}

{* DESIGN: Content END *}</div></div></div>
</div>
{ezscript( array( 'page/content_search_filters.js' ) )}
{undef $page $f $capabilities $search_query $search_has_text $date_fields $period_names $mode_names $sort_names}
