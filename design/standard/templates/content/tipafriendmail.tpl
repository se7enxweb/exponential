{* DO NOT EDIT THIS FILE! Use an override template instead. *}
{*
    The "tip a friend" mail (content/tipafriend). The subject is the one the visitor typed (set by the view).
    Variables: hostname, nodename, node_id, node, your_name, your_email, receivers_name, receivers_email, comment.
    Sets content_type (text/html) and body_text (the plain-text part).

    The look is design:mail/layout.tpl (HTML) and design:mail/layout_text.tpl (text); this template only passes text
    and links, which the layout washes: the names, the addresses and the comment are typed by the visitor.
*}
{def $tf_url = concat( 'https://', $hostname, $node.url_alias|ezurl( 'no' ) )
     $tf_title = 'A page was recommended to you'|i18n( 'design/standard/content/tipafriend' )
     $tf_intro = 'This message was sent to you because "%1 <%2>" thought you might find the page "%3" at %4 interesting.'|i18n( 'design/standard/content/tipafriend',, array( $your_name, $your_email, $nodename, $hostname ) )
     $tf_paragraphs = array()
     $tf_notice = ''
     $tf_buttons = array( hash( 'label', 'Open the page'|i18n( 'design/standard/mail' ), 'url', $tf_url, 'kind', 'primary' ) )
     $tf_note = 'If the button does not work, copy this address into your browser: %url'|i18n( 'design/standard/mail',, hash( '%url', $tf_url ) )
     $tf_footer = 'You get this mail because someone entered your address on %site to share a page with you.'|i18n( 'design/standard/content/tipafriend',, hash( '%site', $hostname ) )}
{if $comment|trim|ne( '' )}
    {set $tf_paragraphs = array( concat( 'Comment by "%1 <%2>"'|i18n( 'design/standard/content/tipafriend',, array( $your_name, $your_email ) ), ':' ) )
         $tf_notice = $comment}
{/if}
{set-block scope=root variable=content_type}text/html{/set-block}
{set-block scope=root variable=body_text}{include uri='design:mail/layout_text.tpl'
    mail_title=$tf_title mail_intro=$tf_intro mail_buttons=$tf_buttons mail_paragraphs=$tf_paragraphs mail_notice=$tf_notice
    mail_footer=$tf_footer}{/set-block}
{include uri='design:mail/layout.tpl'
    mail_title=$tf_title mail_intro=$tf_intro mail_paragraphs=$tf_paragraphs mail_notice=$tf_notice mail_buttons=$tf_buttons
    mail_links_note=$tf_note mail_footer=$tf_footer}
{undef $tf_url $tf_title $tf_intro $tf_paragraphs $tf_notice $tf_buttons $tf_note $tf_footer}
