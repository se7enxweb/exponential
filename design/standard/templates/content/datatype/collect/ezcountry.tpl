{* DO NOT EDIT THIS FILE! Use an override template instead. *}
{default attribute_base=ContentObjectAttribute}
{let class_content=$attribute.class_content}

{def $country = cond( is_set( $#collection_attributes[$attribute.id] ), $#collection_attributes[$attribute.id], $attribute.content.value )}
<select name="{$attribute_base}_country_{$attribute.id}[]" {if $class_content.multiple_choice}multiple="multiple"{else}autocomplete="country"{/if}>
    {if $class_content.multiple_choice|not}
        <option  value="">{'Not specified'|i18n( 'design/standard/content/datatype' )}</option>
    {/if}
{if $country|ne( '' )}
    {if $country|is_array|not}
        {* Backwards compatibility: an old value is the country's name *}
        {include uri='design:country/options.tpl' country_selected=array( $country ) country_multiple=$class_content.multiple_choice}
    {else}
        {include uri='design:country/options.tpl' country_selected_map=$country country_multiple=$class_content.multiple_choice}
    {/if}
{else}
    {include uri='design:country/options.tpl' country_selected_map=$class_content.default_countries country_multiple=$class_content.multiple_choice}
{/if}
</select>

{/let}
{/default}
