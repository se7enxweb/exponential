{* DO NOT EDIT THIS FILE! Use an override template instead. *}
{* A table: the column names, then one row per matrix row, nothing else (no <br /> between cells or rows;
   portions derived from LoveStack, mugoweb/ezpublish-legacy, commit 492a946963, Copyright (C) Mugo Web, GPL v2). *}
{def $matrix = $attribute.content}
<table class="list" cellspacing="0">
<tr>
{foreach $matrix.columns.sequential as $column}
<th>{$column.name|wash( xhtml )}</th>
{/foreach}
</tr>
{foreach $matrix.rows.sequential as $row sequence array( 'bglight', 'bgdark' ) as $row_style}
<tr class="{$row_style}">
    {foreach $row.columns as $cell}
    <td>{$cell|wash( xhtml )}</td>
    {/foreach}
</tr>
{/foreach}
</table>
{undef $matrix}
