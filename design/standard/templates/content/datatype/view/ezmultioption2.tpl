{* DO NOT EDIT THIS FILE! Use an override template instead. *}
{default attribute_base=ContentObjectAttribute}
<script type="text/javascript" src={"javascript/ezmultioption/ezmultioption.js"|ezdesign} charset="iso-8859-1"></script>
{* The rules as data for javascript/ezmultioption/ezmultioption_view.js (no inline script, for a Content Security
   Policy without 'unsafe-inline'): a list of [ option_id, [ [ multioption_id, [ option ids for which the option is
   enabled ] ], ... ] ], everything as strings *}
{def $ezmo_rules = array()
     $ezmo_rule = array()
     $ezmo_items = array()}
{foreach $attribute.content.rules as $ezmo_option_id => $ezmo_rule_list}
    {set $ezmo_rule = array()}
    {foreach $ezmo_rule_list as $ezmo_multioption_id => $ezmo_rule_items}
        {set $ezmo_items = array()}
        {foreach $ezmo_rule_items as $ezmo_item}
            {set $ezmo_items = $ezmo_items|append( concat( $ezmo_item, '' ) )}
        {/foreach}
        {set $ezmo_rule = $ezmo_rule|append( array( concat( $ezmo_multioption_id, '' ), $ezmo_items ) )}
    {/foreach}
    {set $ezmo_rules = $ezmo_rules|append( array( concat( $ezmo_option_id, '' ), $ezmo_rule ) )}
{/foreach}
{section var=GroupList loop=$attribute.content.optiongroup_list}
{include uri='design:content/datatype/view/multioption2/multioption2.tpl' name=ChildGroup1 attribute=$attribute group=$GroupList.item parent_group_id=$attribute.content.group_id depth=1}
{/section}
<script type="text/javascript" src={"javascript/ezmultioption/ezmultioption_view.js"|ezdesign} data-attribute-id="{$attribute.id|wash}" data-rules="{json_encode( $ezmo_rules )|wash}"></script>
{undef $ezmo_rules $ezmo_rule $ezmo_items}
{/default}
