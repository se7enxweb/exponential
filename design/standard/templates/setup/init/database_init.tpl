{* DO NOT EDIT THIS FILE! Use an override template instead. *}
{*?template charset=latin1?*}

<div align="center">
  <h1>{"Database initialization"|i18n("design/standard/setup/init")}</h1>
</div>

{if $db_error}
  <blockquote class="error">
  <p>
      {$db_error.text}
  </p>
  {if $db_error.url}
      <a href="{$db_error.url.href}" target="_other">{$db_error.url.text|wash}</a>
  {/if}
  </blockquote>
{/if}

<p>
{"Please input database access information in the form below."|i18n("design/standard/setup/init")}
</p>

<form method="post" action="{$script}">

{if eq( $db_not_empty, 1 )}
<h2>{"Warning"|i18n("design/standard/setup/init")}</h2>
<p>
 {"Your database already contains data."|i18n("design/standard/setup/init")}
 {"The setup can continue with the initialization but may damage the present data."|i18n("design/standard/setup/init")}
</p>
<p>
 {"What do you want the setup to do?"|i18n("design/standard/setup/init")}
</p>

<blockquote class="note">
<p>
 <b>{"Note"|i18n("design/standard/setup/init")}:</b>
 {"The setup will not do an upgrade from older Exponential versions (such as 2.2.7) if you leave the data as it is. This is only meant for people who have existing data that they don't want to lose. If you have existing Exponential 4.0 data (such as from an RC release) you should skip DB initialization, however you will then need to do a manual upgrade."|i18n("design/standard/setup/init")}
</p>
</blockquote>

<fieldset>
<legend>{"Database choice"|i18n( 'design/standard/setup/init' )}:</legend>

<table cellspacing="3" cellpadding="0" border="0">
<tr>
 <td class="normal">
  <p>{"Continue but leave the data as it is."|i18n("design/standard/setup/init")}</p>
 </td>
 <td rowspan="4" class="normal">
  &nbsp;&nbsp;
 </td>
 <td class="normal">
  <input type="radio" name="eZSetupDatabaseDataChoice" value="1" />
 </td>
</tr>
<tr>
 <td class="normal">
  <p>{"Continue but remove the data first."|i18n("design/standard/setup/init")}</p>
 </td>
 <td class="normal">
  <input type="radio" name="eZSetupDatabaseDataChoice" value="2"  checked="checked" />
 </td>
</tr>
<tr>
 <td class="normal">
  <p>{"Keep data and skip database initialization."|i18n("design/standard/setup/init")}</p>
 </td>
 <td class="normal">
  <input type="radio" name="eZSetupDatabaseDataChoice" value="3" />
 </td>
</tr>
<tr>
 <td class="normal">
  <p>{"Let me choose a new database."|i18n("design/standard/setup/init")}</p>
 </td>
 <td class="normal">
  <input type="radio" name="eZSetupDatabaseDataChoice" value="4" />
 </td>
</tr>
</table>
</fieldset>
{/if}

<fieldset>
<legend>{'Database'|i18n( 'design/standard/setup/init' )}:</legend>
<table border="0" cellspacing="3" cellpadding="0">
<tr>
  <th class="label" colspan="3"></th>
</tr>
<tr>
  <td class="normal"><label class="textfield">{"Type"|i18n("design/standard/setup/init")}</label></td>
  <td rowspan="7" class="normal">&nbsp;&nbsp;</td>
  <td class="normal">
  {$database_info.info.name|wash}
  </td>
</tr>
{if or( $database_info.info.type|eq('libsql'), $database_info.info.type|eq('turso') )}
<tr>
  <td class="normal" colspan="3"><input type="hidden" name="eZSetupLibSQLPage" value="1" />
  {if $libsql.turso}
  <p>{"Turso keeps the database in its cloud and is reached over HTTPS with the database's auth token. Give the database URL Turso shows (libsql://...), and the token."|i18n("design/standard/setup/init")}</p>
  {else}
  <p>{"libSQL is SQLite's fork: the site uses SQLite's schema, either on a libSQL server (sqld) reached over HTTP, or in a local file (the embedded file mode, no server)."|i18n("design/standard/setup/init")}</p>
  {/if}
  </td>
</tr>
{if $libsql.turso|not}
<tr>
  <td class="normal"><label class="textfield">{"Mode"|i18n("design/standard/setup/init")}:</label></td>
  <td class="normal">
  <label><input type="radio" name="eZSetupLibSQLMode" value="remote"{if $libsql.mode|eq('remote')} checked="checked"{/if} /> {"A libSQL server (sqld)"|i18n("design/standard/setup/init")}</label><br />
  <label><input type="radio" name="eZSetupLibSQLMode" value="file"{if $libsql.mode|eq('file')} checked="checked"{/if} /> {"The embedded file mode: a local file, no server"|i18n("design/standard/setup/init")}</label>
  </td>
</tr>
{/if}
<tr>
  <th class="label" colspan="3">{"Server"|i18n("design/standard/setup/init")}</th>
</tr>
<tr>
  <td class="normal"><label class="textfield" for="eZSetupLibSQLURL">{"Server URL"|i18n("design/standard/setup/init")}:</label></td>
  <td class="normal"><input type="text" id="eZSetupLibSQLURL" name="eZSetupLibSQLURL" size="40" value="{$libsql.url|wash}" placeholder="http://127.0.0.1:8080" /><br />
  <small>{"Optional: replaces the server name and port (http://host:port, https://host, libsql://host)."|i18n("design/standard/setup/init")}</small></td>
</tr>
<tr>
  <td class="normal"><label class="textfield">{"Servername"|i18n("design/standard/setup/init")}:</label></td>
  <td class="normal"><input type="text" name="eZSetupDatabaseServer" size="24" value="{$database_info.server|wash}" /></td>
</tr>
<tr>
  <td class="normal"><label class="textfield">{"Port"|i18n("design/standard/setup/init")}:</label></td>
  <td class="normal"><input type="text" name="eZSetupDatabasePort" size="8" value="{$database_info.port|wash}" /></td>
</tr>
{if $libsql.turso|not}
<tr>
  <td class="normal"><label class="textfield" for="eZSetupLibSQLTLS">{"TLS (https)"|i18n("design/standard/setup/init")}:</label></td>
  <td class="normal"><input type="checkbox" id="eZSetupLibSQLTLS" name="eZSetupLibSQLTLS" value="1"{if $libsql.tls} checked="checked"{/if} /></td>
</tr>
{/if}
<tr>
  <td class="normal"><label class="textfield" for="eZSetupLibSQLCAFile">{"CA file (optional)"|i18n("design/standard/setup/init")}:</label></td>
  <td class="normal"><input type="text" id="eZSetupLibSQLCAFile" name="eZSetupLibSQLCAFile" size="40" value="{$libsql.cafile|wash}" /><br />
  <small>{"The full path of a PEM file that checks the server's certificate; empty: the system's certificate authorities."|i18n("design/standard/setup/init")}</small></td>
</tr>
<tr>
  <td class="normal"><label class="textfield" for="eZSetupLibSQLToken">{"Auth token"|i18n("design/standard/setup/init")}:</label></td>
  <td class="normal"><input type="password" id="eZSetupLibSQLToken" name="eZSetupLibSQLToken" size="40" value="" autocomplete="new-password" /><br />
  <small>{if $libsql.token_kept}{"A token was given before and is kept; leave the field empty to keep it."|i18n("design/standard/setup/init")}{else}{"Empty when the server needs none (sqld without --auth-jwt-key-file)."|i18n("design/standard/setup/init")}{/if}</small></td>
</tr>
<tr>
  <td class="normal"><label class="textfield">{"Database name"|i18n("design/standard/setup/init")}:</label></td>
  <td class="normal"><input type="text" name="eZSetupDatabaseName" size="24" value="{$database_info.dbname|wash}" /></td>
</tr>
{if $libsql.turso|not}
<tr>
  <th class="label" colspan="3">{"Embedded file mode"|i18n("design/standard/setup/init")}</th>
</tr>
<tr>
  <td class="normal"><label class="textfield" for="eZSetupLibSQLFile">{"Database file name"|i18n("design/standard/setup/init")}:</label></td>
  <td class="normal"><input type="text" id="eZSetupLibSQLFile" name="eZSetupLibSQLFile" size="24" value="{$libsql.file|wash}" /><br />
  <small>{"In the directory %directory of this installation, as an SQLite site's file; created if it does not exist. Needs PHP's sqlite3 extension."|i18n("design/standard/setup/init",, hash( '%directory', $database_directory|wash ))}</small></td>
</tr>
{/if}
{elseif and( $database_info.info.type|ne('sqlite3'), $database_info.info.type|ne('duckdb') )}
<tr>
  <td class="normal"><label class="textfield">{"Servername"|i18n("design/standard/setup/init")}:</label></td>
  <td class="normal"><input type="text" name="eZSetupDatabaseServer" size="16" value="{$database_info.server|wash}" /></td>
</tr>
<tr>
  <td class="normal"><label class="textfield">{"Port"|i18n("design/standard/setup/init")}:</label></td>
  <td class="normal"><input type="text" name="eZSetupDatabasePort" size="16" value="{$database_info.port|wash}" /></td>
</tr>
<tr>
  <td class="normal"><label class="textfield">{"Username"|i18n("design/standard/setup/init")}:</label></td>
  <td class="normal"><input type="text" name="eZSetupDatabaseUser" size="16" value="{$database_info.user|wash}" /></td>
</tr>
<tr>
  <td class="normal"><label class="textfield">{"Password"|i18n("design/standard/setup/init")}:</label></td>
  <td class="normal"><input type="password" name="eZSetupDatabasePassword" size="16" value="{$database_info.password|wash}" /></td>
</tr>
<tr>
  <td class="normal"><label class="textfield">{"Database name"|i18n("design/standard/setup/init")}:</label></td>
  <td class="normal"><input type="text" name="eZSetupDatabaseName" size="16" value="{$database_info.dbname|wash}" /></td>
</tr>
{else}
<tr>
  <td class="normal"><label class="textfield">{"Database file name"|i18n("design/standard/setup/init")}:</label></td>
  <td class="normal"><input type="text" name="eZSetupDatabaseName" size="24" value="{$database_info.dbname|wash}" /></td>
</tr>
<tr>
  <td class="normal"></td>
  <td class="normal">
  {if $database_info.info.type|eq('duckdb')}
  <p>{"DuckDB keeps the whole database in one file, in the directory %directory of this installation. It needs no server, user or password, but PHP's FFI extension with ffi.enable=true and the libduckdb library ([DuckDBSettings] Library in site.ini). The file is created if it does not exist."|i18n("design/standard/setup/init",, hash( '%directory', $database_directory|wash ))}</p>
  {else}
  <p>{"SQLite keeps the whole database in one file, in the directory %directory of this installation. It needs no server, user or password. The file is created if it does not exist; if it already holds tables, the Site details page asks what to do with them."|i18n("design/standard/setup/init",, hash( '%directory', $database_directory|wash ))}</p>
  {/if}
  </td>
</tr>
{/if}
{if or(eq($database_info.info.driver,'ezmysql'), eq($database_info.info.driver,'ezmysqli'))}
<tr>
  <td class="normal"><label class="textfield">{"Socket (optional)"|i18n("design/standard/setup/init")}:</label></td>
  <td class="normal"><input type="text" name="eZSetupDatabaseSocket" size="16" value="{$database_info.socket|wash}" /></td>
</tr>
{/if}
</table>
</fieldset>
  {include uri='design:setup/init/navigation.tpl'}
  {include uri="design:setup/persistence.tpl"}
</form>
