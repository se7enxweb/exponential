{* DO NOT EDIT THIS FILE! Use an override template instead. *}
{* The page after a registration (user/success): the state of the new account, then the next steps.

   $registration_state (kernel/private/classes/views/user/success.php): verify_email, pending_approval, active,
   signed_in or error; $registered_user is the account of the registration, or false. The message is a live region
   (role="status", role="alert" for an error); the next steps are a nav named by its heading, with Sign in (not
   signed in, the account active), My profile and Edit profile (signed in), Register (after an error), Home, and the
   sitemap and the tag cloud of the content root. A design that has its own result page overrides this template. *}
{def $su_state = 'active'
     $su_user = false()
     $su_current = fetch( 'user', 'current_user' )
     $su_root = ezini( 'NodeSettings', 'RootNode', 'content.ini' )
     $su_title = 'User registered'|i18n( 'design/standard/user' )
     $su_texts = array()
     $su_role = 'status'}
{if is_set( $registration_state )}{set $su_state = $registration_state}{elseif is_set( $verify_user_email )}{if $verify_user_email}{set $su_state = 'verify_email'}{/if}{/if}
{if is_set( $registered_user )}{set $su_user = $registered_user}{/if}
{switch match=$su_state}
{case match='verify_email'}
    {set $su_title = 'Check your e-mail'|i18n( 'design/standard/user/success' )
         $su_texts = array( 'Your account has been created. One step is left: confirm your e-mail address.'|i18n( 'design/standard/user/success' ) )}
    {if $su_user}
    {set $su_texts = $su_texts|append( 'We sent a message to %email. Open the link in it to activate your account; then you can sign in.'|i18n( 'design/standard/user/success',, hash( '%email', $su_user.email ) ) )}
    {else}
    {set $su_texts = $su_texts|append( 'We sent a message to the e-mail address you entered. Open the link in it to activate your account; then you can sign in.'|i18n( 'design/standard/user/success' ) )}
    {/if}
    {set $su_texts = $su_texts|append( 'No message after a few minutes? Look in your spam folder.'|i18n( 'design/standard/user/success' ) )}
{/case}
{case match='pending_approval'}
    {set $su_title = 'Your account is waiting for approval'|i18n( 'design/standard/user/success' )
         $su_texts = array( 'Your account has been created. An administrator checks new accounts before they can be used.'|i18n( 'design/standard/user/success' ),
                            'You will get an e-mail as soon as your account is approved; then you can sign in.'|i18n( 'design/standard/user/success' ) )}
{/case}
{case match='signed_in'}
    {set $su_title = 'Welcome, %name'|i18n( 'design/standard/user/success',, hash( '%name', $su_current.contentobject.name ) )
         $su_texts = array( 'Your account is ready and you are signed in.'|i18n( 'design/standard/user/success' ) )}
{/case}
{case match='error'}
    {set $su_title = 'We could not find your account'|i18n( 'design/standard/user/success' )
         $su_role = 'alert'
         $su_texts = array( 'The account of this registration does not exist (any more).'|i18n( 'design/standard/user/success' ),
                            'Please register again, or contact us if the problem stays.'|i18n( 'design/standard/user/success' ) )}
{/case}
{case}
    {set $su_title = 'Your account is ready'|i18n( 'design/standard/user/success' )
         $su_texts = array( 'Your account has been created. You can sign in now.'|i18n( 'design/standard/user/success' ) )}
{/case}
{/switch}

<div class="user-success" data-exp-result-state="{$su_state|wash}">
<div class="maincontentheader">
<h1>{$su_title|wash}</h1>
</div>

<div class="feedback" role="{$su_role}">
{foreach $su_texts as $su_text}
<p>{$su_text|wash}</p>
{/foreach}
</div>

<nav class="user-success-next" aria-labelledby="user-success-next-title">
<h2 id="user-success-next-title">{'Next steps'|i18n( 'design/standard/user/success' )}</h2>
<ul>
{if and( $su_current.is_logged_in|not, $su_state|eq( 'active' ) )}
    <li><a href={'/user/login'|ezurl} data-exp-rn="login">{'Sign in'|i18n( 'design/standard/user/success' )}</a></li>
{/if}
{if $su_current.is_logged_in}
    {if fetch( 'user', 'can_open', hash( 'uri', 'user/edit' ) )}
    <li><a href={'/user/edit'|ezurl} data-exp-rn="profile">{'My profile'|i18n( 'design/standard/user/success' )}</a></li>
    {/if}
    {if $su_current.contentobject.can_edit}
    <li><a href={concat( '/content/edit/', $su_current.contentobject_id, '/' )|ezurl} data-exp-rn="edit">{'Edit profile'|i18n( 'design/standard/user/success' )}</a></li>
    {/if}
{/if}
{if and( $su_state|eq( 'error' ), $su_current.is_logged_in|not, fetch( 'user', 'can_open', hash( 'uri', 'user/register' ) ) )}
    <li><a href={'/user/register'|ezurl} data-exp-rn="register">{'Register'|i18n( 'design/standard/user/success' )}</a></li>
{/if}
    <li><a href={'/'|ezurl} data-exp-rn="home">{'Home'|i18n( 'design/standard/user/success' )}</a></li>
    <li><a href={concat( '/content/view/sitemap/', $su_root )|ezurl} data-exp-rn="sitemap">{'Sitemap'|i18n( 'design/standard/user/success' )}</a></li>
    <li><a href={concat( '/content/view/tagcloud/', $su_root )|ezurl} data-exp-rn="tagcloud">{'Tag cloud'|i18n( 'design/standard/user/success' )}</a></li>
</ul>
</nav>
</div>
{undef $su_state $su_user $su_current $su_root $su_title $su_texts $su_role}
