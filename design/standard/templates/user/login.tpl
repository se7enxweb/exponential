{* DO NOT EDIT THIS FILE! Use an override template instead. *}
{* With passkeys on (site.ini [PasskeySettings]) the form also signs in with a passkey: the button and the browser's
   passkey autofill of the username field (design:javascript/exp_passkey.js, doc/eng-us/guides/passkeys.md) *}
{def $passkey_options = first_set( $passkey_options, '' )}
<form method="post" action={"/user/login/"|ezurl}{if $passkey_options} data-exp-passkey="login"{if first_set( $passkey_warning, false() )|not} data-exp-passkey-autofill="1"{/if} data-exp-passkey-options="{$passkey_options|wash}"
      data-msg-working="{'Follow the steps of your browser or device.'|i18n( 'design/standard/user/passkeys' )|wash}"
      data-msg-cancelled="{'The passkey dialog was closed. You can sign in with your password instead.'|i18n( 'design/standard/user/passkeys' )|wash}"
      data-msg-failed="{'The passkey could not be used. Please try again, or sign in with your password.'|i18n( 'design/standard/user/passkeys' )|wash}"{/if}>

<div class="maincontentheader">
<h1>{"Login"|i18n("design/standard/user")}</h1>
</div>

{if first_set( $passkey_warning, false() )}
<div class="warning" role="alert">
<h2>{'Could not sign in with the passkey'|i18n( 'design/standard/user/passkeys' )}</h2>
<p>{$passkey_warning|wash}</p>
</div>
{/if}

{if $User:warning.bad_login}
<div class="warning">
<h2>{"Could not login"|i18n("design/standard/user")}</h2>
<ul>
    <li>{"A valid username and password is required to login."|i18n("design/standard/user")}</li>
</ul>
</div>
{else}

{if $site_access.allowed|not}
<div class="warning">
<h2>{"Access not allowed"|i18n("design/standard/user")}</h2>
<ul>
    <li>{"You are not allowed to access %1."|i18n("design/standard/user",,array($site_access.name))}</li>
</ul>
</div>
{/if}

{/if}

<div class="block">
<label for="id1">{"Username"|i18n("design/standard/user",'User name')}</label><div class="labelbreak"></div>
<input class="halfbox" type="text" size="10" name="Login" id="id1" value="{$User:login|wash}" tabindex="1" autocomplete="{if $passkey_options}username webauthn{else}username{/if}" />
</div>
<div class="block">
<label for="id2">{"Password"|i18n("design/standard/user")}</label><div class="labelbreak"></div>
<input class="halfbox" type="password" size="10" name="Password" id="id2" value="" tabindex="1" autocomplete="current-password" />
</div>

{if and( ezini_hasvariable( 'Session', 'RememberMeTimeout' ), ezini( 'Session', 'RememberMeTimeout' ) )}
    <div class="block">
        <input type="checkbox" tabindex="1" name="Cookie" id="id3" checked="checked" /><label for="id3" style="display:inline;">{"Remember me"|i18n("design/admin/user/login")}</label>
    </div>
{/if}

<div class="buttonblock">
<input class="defaultbutton" type="submit" name="LoginButton" value="{'Login'|i18n('design/standard/user','Button')}" tabindex="1" />
{* Sign Up only for a user who may register (policy omit list or the user/register policy) *}
{if fetch( 'user', 'can_open', hash( 'uri', 'user/register' ) )}
<input class="button" type="submit" name="RegisterButton" value="{'Sign Up'|i18n('design/standard/user','Button')}" tabindex="1" />
{/if}
</div>

{if $passkey_options}
<div class="buttonblock" data-exp-passkey-only="1" hidden="hidden">
<button class="button" type="button" data-exp-passkey-start="1" tabindex="1">{'Sign in with a passkey'|i18n( 'design/standard/user/passkeys' )}</button>
</div>
<p class="feedback" data-exp-passkey-status="1" role="status" aria-live="polite" hidden="hidden"></p>
{/if}

{if ezini( 'SiteSettings', 'LoginPage' )|eq( 'custom' )}
    <p><a href={'/user/forgotpassword'|ezurl}>{'Forgot your password?'|i18n( 'design/standard/user' )}</a></p>
{/if}

<input type="hidden" name="RedirectURI" value="{$User:redirect_uri|wash}" />

{section show=and( is_set( $User:post_data ), is_array( $User:post_data ) )}
  {section name=postData loop=$User:post_data }
     <input name="Last_{$postData:key|wash}" value="{$postData:item|wash}" type="hidden" /><br/>
  {/section}
{/section}
</form>
{if $passkey_options}<script src={'javascript/exp_passkey.js'|ezdesign} defer="defer"></script>{/if}
{undef $passkey_options}
