{* DO NOT EDIT THIS FILE! Use an override template instead. *}
{*
    The mail to a user whose registration is finished: activated and published
    (kernel/user/ezuseroperationcollection.php, sendUserNotification()).

    Variables of the mail:
    - user  eZUser (login, email)

    Variables that can be set in a set-block to customize the e-mail sent :
    - subject (default is "User registration approved")
    - content_type (like described in site.ini/[MailSettings].ContentType); text/html here
    - body_text (the plain-text part; with an HTML content_type the mail is sent as text and HTML)
    - email_sender (default is site.ini/[MailSettings].AdminEmail)

    The look is design:mail/layout.tpl (HTML) and design:mail/layout_text.tpl (text); this template only passes text
    and links (the layout washes them). The sign-in link is on the site's address ([SiteSettings] SiteURL), https.
*}
{def $ra_site_url = ezini( 'SiteSettings', 'SiteURL' )
     $ra_login = ''
     $ra_rows = array()
     $ra_buttons = array()}
{set-block scope=root variable=subject}{'%siteurl registration approved'|i18n( 'design/standard/user/register',, hash( '%siteurl', $ra_site_url ) )}{/set-block}
{set-block scope=root variable=content_type}text/html{/set-block}
{set $ra_login = concat( 'https://', $ra_site_url, '/user/login' )
     $ra_rows = array( hash( 'label', 'Username'|i18n( 'design/standard/user/register' ), 'value', $user.login ),
                       hash( 'label', 'Email'|i18n( 'design/standard/user/register' ), 'value', $user.email ) )
     $ra_buttons = array( hash( 'label', 'Sign in'|i18n( 'design/standard/user/register' ), 'url', $ra_login, 'kind', 'primary' ) )}
{set-block scope=root variable=body_text}{include uri='design:mail/layout_text.tpl'
    mail_title='Your account is ready'|i18n( 'design/standard/user/register' )
    mail_intro='Your registration has been approved. You can login with your account %username.'|i18n( 'design/standard/user/register', '', hash( '%username', $user.login ) )
    mail_rows=$ra_rows
    mail_buttons=$ra_buttons
    mail_footer='This mail was sent by %siteurl because your registration was approved.'|i18n( 'design/standard/user/register', '', hash( '%siteurl', $ra_site_url ) )}{/set-block}
{include uri='design:mail/layout.tpl'
    mail_title='Your account is ready'|i18n( 'design/standard/user/register' )
    mail_intro='Your registration has been approved. You can login with your account %username.'|i18n( 'design/standard/user/register', '', hash( '%username', $user.login ) )
    mail_rows=$ra_rows
    mail_buttons=$ra_buttons
    mail_footer='This mail was sent by %siteurl because your registration was approved.'|i18n( 'design/standard/user/register', '', hash( '%siteurl', $ra_site_url ) )}
{undef $ra_site_url $ra_login $ra_rows $ra_buttons}
