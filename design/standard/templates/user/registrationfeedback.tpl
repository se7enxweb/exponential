{* DO NOT EDIT THIS FILE! Use an override template instead. *}
{*
    The administrator's "New user registered" mail (kernel/private/classes/views/user/register.php).

    Variables of the mail:
    - user                eZUser (login, email, contentobject_id)
    - object              the user's eZContentObject (name, id, published)
    - hostname            host name of the site
    - registration_links  false, or a hash: view, approve, reject (signed links to the administration), pending (the
                          approval item or ''), unactivated (the list of unactivated users), expires (timestamp)
    - registration_state  false, or email|administrator|workflow|pending|active

    Variables that can be set in a set-block to customize the e-mail sent :
    - subject (default is "New user registered")
    - content_type (like described in site.ini/[MailSettings].ContentType); text/html here
    - body_text (the plain-text part; with an HTML content_type the mail is sent as text and HTML)
    - email_sender (default is site.ini/[MailSettings].AdminEmail)
    - email_receiver (default is site.ini/[UserSettings].RegistrationEmail. If not set, it is site.ini/[MailSettings].AdminEmail

    The look is design:mail/layout.tpl (HTML) and design:mail/layout_text.tpl (text); this template only passes text
    and links (the layout washes them). A design overrides mail/layout.tpl for its own look.
*}
{set-block scope=root variable=subject}{'New user registered at %siteurl'|i18n('design/standard/user/register',,hash('%siteurl',ezini('SiteSettings','SiteURL')))}{/set-block}
{set-block scope=root variable=content_type}text/html{/set-block}
{def $rf_state = first_set( $registration_state, false() )
     $rf_links = first_set( $registration_links, false() )
     $rf_waiting = false()
     $rf_status = ''
     $rf_notice = ''
     $rf_published = first_set( $object.published, 0 )
     $rf_rows = array()
     $rf_buttons = array()
     $rf_more = array()
     $rf_note = ''}
{if $rf_published|gt( 0 )|not}{set $rf_published = currentdate()}{/if}
{switch match=$rf_state}
{case match='email'}
    {set $rf_waiting = true()
         $rf_status = 'Waiting for the user to confirm the email address.'|i18n( 'design/standard/user/register' )
         $rf_notice = 'You can activate the account now or wait until the user confirms the email address.'|i18n( 'design/standard/user/register' )}
{/case}
{case match='administrator'}
    {set $rf_waiting = true()
         $rf_status = 'Disabled until an administrator activates it.'|i18n( 'design/standard/user/register' )
         $rf_notice = 'The user cannot sign in until you activate the account.'|i18n( 'design/standard/user/register' )}
{/case}
{case match='workflow'}
    {set $rf_waiting = true()
         $rf_status = 'Waiting for approval before it is published.'|i18n( 'design/standard/user/register' )
         $rf_notice = 'The account is published only after it is approved.'|i18n( 'design/standard/user/register' )}
{/case}
{case match='pending'}
    {set $rf_status = 'Enabled, but not yet published.'|i18n( 'design/standard/user/register' )}
{/case}
{case match='active'}
    {set $rf_status = 'Active.'|i18n( 'design/standard/user/register' )}
{/case}
{case}{/case}
{/switch}
{set $rf_rows = array( hash( 'label', 'Name'|i18n( 'design/standard/user/register' ), 'value', $object.name ),
                       hash( 'label', 'Username'|i18n( 'design/standard/user/register', 'Login name' ), 'value', $user.login ),
                       hash( 'label', 'Email'|i18n( 'design/standard/user/register' ), 'value', $user.email ),
                       hash( 'label', 'Registered at'|i18n( 'design/standard/user/register' ), 'value', $rf_published|l10n( 'shortdatetime' ) ) )}
{if $rf_status|ne( '' )}
    {set $rf_rows = $rf_rows|append( hash( 'label', 'Account status'|i18n( 'design/standard/user/register' ), 'value', $rf_status ) )}
{/if}
{if $rf_links}
    {if $rf_waiting}
        {set $rf_buttons = $rf_buttons|append( hash( 'label', cond( $rf_state|eq( 'workflow' ), 'Approve'|i18n( 'design/standard/user/register' ), 'Activate account'|i18n( 'design/standard/user/register' ) ), 'url', $rf_links.approve, 'kind', 'primary' ) )}
        {set $rf_buttons = $rf_buttons|append( hash( 'label', 'View account'|i18n( 'design/standard/user/register' ), 'url', $rf_links.view, 'kind', 'secondary' ) )}
        {set $rf_buttons = $rf_buttons|append( hash( 'label', 'Reject and remove'|i18n( 'design/standard/user/register' ), 'url', $rf_links.reject, 'kind', 'danger' ) )}
    {else}
        {set $rf_buttons = $rf_buttons|append( hash( 'label', 'View account'|i18n( 'design/standard/user/register' ), 'url', $rf_links.view, 'kind', 'primary' ) )}
    {/if}
    {if first_set( $rf_links.pending, '' )|ne( '' )}
        {set $rf_buttons = $rf_buttons|append( hash( 'label', 'Open approval item'|i18n( 'design/standard/user/register' ), 'url', $rf_links.pending, 'kind', 'secondary' ) )}
    {/if}
    {if first_set( $rf_links.unactivated, '' )|ne( '' )}
        {set $rf_more = $rf_more|append( hash( 'label', 'All unactivated users'|i18n( 'design/standard/user/register' ), 'url', $rf_links.unactivated ) )}
    {/if}
    {set $rf_note = 'These links open the administration. You need to sign in, and you are asked to confirm before anything changes. Links that change the account work once. All links stop working on %expires.'|i18n( 'design/standard/user/register', '', hash( '%expires', $rf_links.expires|l10n( 'shortdatetime' ) ) )}
{/if}
{set-block scope=root variable=body_text}{include uri='design:mail/layout_text.tpl'
    mail_title='New user registered'|i18n( 'design/standard/user/register' )
    mail_intro='A new user has registered.'|i18n( 'design/standard/user/register' )
    mail_rows=$rf_rows
    mail_notice=$rf_notice
    mail_buttons=$rf_buttons
    mail_links=$rf_more
    mail_links_note=$rf_note
    mail_footer='This mail was sent by %siteurl because a new user registered.'|i18n( 'design/standard/user/register', '', hash( '%siteurl', ezini( 'SiteSettings', 'SiteURL' ) ) )}{/set-block}
{include uri='design:mail/layout.tpl'
    mail_title='New user registered'|i18n( 'design/standard/user/register' )
    mail_intro='A new user has registered.'|i18n( 'design/standard/user/register' )
    mail_rows=$rf_rows
    mail_notice=$rf_notice
    mail_buttons=$rf_buttons
    mail_links=$rf_more
    mail_links_note=$rf_note
    mail_footer='This mail was sent by %siteurl because a new user registered.'|i18n( 'design/standard/user/register', '', hash( '%siteurl', ezini( 'SiteSettings', 'SiteURL' ) ) )}
{undef $rf_state $rf_links $rf_waiting $rf_status $rf_notice $rf_published $rf_rows $rf_buttons $rf_more $rf_note}
