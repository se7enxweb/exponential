{* DO NOT EDIT THIS FILE! Use an override template instead. *}
{*
    The mail to a new user after registration (kernel/user/ezuseroperationcollection.php, sendActivationEmail()):
    with [UserSettings] VerifyUserType=email it carries the activation link.

    Variables of the mail:
    - user      eZUser (login, email)
    - object    the user's eZContentObject (main_node_id: the second part of the activation link, as user/activate
                checks it; empty while the account is not published)
    - hostname  host name of the request (the activation link is built on it)
    - hash      the activation key, when the account has to be activated
    - password  the password, shown only with [UserSettings] PasswordInRegistrationEmail=enabled

    Variables that can be set in a set-block to customize the e-mail sent :
    - subject (default is "Registration info")
    - content_type (like described in site.ini/[MailSettings].ContentType); text/html here
    - body_text (the plain-text part; with an HTML content_type the mail is sent as text and HTML)
    - email_sender (default is site.ini/[MailSettings].AdminEmail)

    The look is design:mail/layout.tpl (HTML) and design:mail/layout_text.tpl (text); this template only passes text
    and links (the layout washes them). Links are absolute and use https.
*}
{def $ri_site_url = ezini( 'SiteSettings', 'SiteURL' )
     $ri_host = first_set( $hostname, '' )
     $ri_hash = first_set( $hash, false() )
     $ri_activate = ''
     $ri_login = ''
     $ri_title = ''
     $ri_notice = ''
     $ri_note = ''
     $ri_rows = array()
     $ri_buttons = array()
     $ri_more = array()}
{set-block scope=root variable=subject}{'%1 registration info'|i18n('design/standard/user/register',,array($ri_site_url))}{/set-block}
{set-block scope=root variable=content_type}text/html{/set-block}
{if $ri_host|eq( '' )}{set $ri_host = $ri_site_url}{/if}
{set $ri_login = concat( 'https://', $ri_host, 'user/login'|ezurl( 'no' ) )}
{set $ri_rows = array( hash( 'label', 'Username'|i18n( 'design/standard/user/register' ), 'value', $user.login ),
                       hash( 'label', 'Email'|i18n( 'design/standard/user/register' ), 'value', $user.email ) )}
{if and( is_set( $password ), ezini( 'UserSettings', 'PasswordInRegistrationEmail' )|eq( 'enabled' ) )}
    {set $ri_rows = $ri_rows|append( hash( 'label', 'Password'|i18n( 'design/standard/user/register' ), 'value', $password ) )}
{/if}
{if $ri_hash}
    {set $ri_activate = concat( 'https://', $ri_host, concat( 'user/activate/', $ri_hash, '/', $object.main_node_id )|ezurl( 'no' ) )
         $ri_title = 'Confirm your email address'|i18n( 'design/standard/user/register' )
         $ri_notice = 'Click the button to confirm your email address and activate your account.'|i18n( 'design/standard/user/register' )}
    {set $ri_buttons = array( hash( 'label', 'Activate account'|i18n( 'design/standard/user/register' ), 'url', $ri_activate, 'kind', 'primary' ) )
         $ri_more = array( hash( 'label', 'Sign in'|i18n( 'design/standard/user/register' ), 'url', $ri_login ) )
         $ri_note = concat( 'If the button does not work, copy this address into your browser: %url'|i18n( 'design/standard/user/register', '', hash( '%url', $ri_activate ) ),
                            ' ', 'If you did not register, you can ignore this mail.'|i18n( 'design/standard/user/register' ) )}
{else}
    {set $ri_title = 'Your account information'|i18n( 'design/standard/user/register' )
         $ri_buttons = array( hash( 'label', 'Sign in'|i18n( 'design/standard/user/register' ), 'url', $ri_login, 'kind', 'primary' ) )}
{/if}
{set-block scope=root variable=body_text}{include uri='design:mail/layout_text.tpl'
    mail_title=$ri_title
    mail_intro='Thank you for registering at %siteurl.'|i18n( 'design/standard/user/register', '', hash( '%siteurl', $ri_site_url ) )
    mail_rows=$ri_rows
    mail_notice=$ri_notice
    mail_buttons=$ri_buttons
    mail_links=$ri_more
    mail_links_note=$ri_note
    mail_footer='This mail was sent by %siteurl because this email address was used to register an account.'|i18n( 'design/standard/user/register', '', hash( '%siteurl', $ri_site_url ) )}{/set-block}
{include uri='design:mail/layout.tpl'
    mail_title=$ri_title
    mail_intro='Thank you for registering at %siteurl.'|i18n( 'design/standard/user/register', '', hash( '%siteurl', $ri_site_url ) )
    mail_rows=$ri_rows
    mail_notice=$ri_notice
    mail_buttons=$ri_buttons
    mail_links=$ri_more
    mail_links_note=$ri_note
    mail_footer='This mail was sent by %siteurl because this email address was used to register an account.'|i18n( 'design/standard/user/register', '', hash( '%siteurl', $ri_site_url ) )}
{undef $ri_site_url $ri_host $ri_hash $ri_activate $ri_login $ri_title $ri_notice $ri_note $ri_rows $ri_buttons $ri_more}
