{* DO NOT EDIT THIS FILE! Use an override template instead. *}
{*
    The "forgot your password" mails (user/forgotpassword, and the account service of expservices). Sent twice:
    1. link true:  the link to confirm the reset, with hash_key (and key_lifetime_minutes, how long it works);
    2. link false: after the link was opened, the new password.
    Variables: user (eZUser: login, email), object, link, hash_key, password, key_lifetime_minutes.
    Sets subject, content_type (text/html) and body_text (the plain-text part); category security.

    The look is design:mail/layout.tpl (HTML) and design:mail/layout_text.tpl (text); this template only passes text
    and links, which the layout washes.
*}
{def $fp_site = ezini( 'SiteSettings', 'SiteName' )
     $fp_link = first_set( $link, false() )
     $fp_minutes = first_set( $key_lifetime_minutes, 0 )
     $fp_url = ''
     $fp_login = 'user/login'|ezurl( 'no', 'full' )
     $fp_title = ''
     $fp_intro = ''
     $fp_code = ''
     $fp_code_label = ''
     $fp_notice = ''
     $fp_note = ''
     $fp_buttons = array()
     $fp_outro = array()
     $fp_rows = array( hash( 'label', 'Username'|i18n( 'design/standard/user/register' ), 'value', $user.login ),
                       hash( 'label', 'Email'|i18n( 'design/standard/user/forgotpassword' ), 'value', $user.email ) )}
{if $fp_login|begins_with( 'http://' )}{set $fp_login = concat( 'https://', $fp_login|extract( 7 ) )}{/if}
{if $fp_link}
    {set $fp_url = concat( 'user/forgotpassword/', $hash_key, '/' )|ezurl( 'no', 'full' )}
    {if $fp_url|begins_with( 'http://' )}{set $fp_url = concat( 'https://', $fp_url|extract( 7 ) )}{/if}
    {set $fp_title = 'Reset your password'|i18n( 'design/standard/user/forgotpassword' )
         $fp_intro = 'Someone asked to reset the password of your account on %site. Confirm with the button, and we will send you a new password in a second mail.'|i18n( 'design/standard/user/forgotpassword',, hash( '%site', $fp_site ) )}
    {set $fp_buttons = array( hash( 'label', 'Reset my password'|i18n( 'design/standard/user/forgotpassword' ), 'url', $fp_url, 'kind', 'primary' ) )
         $fp_note = 'If the button does not work, copy this address into your browser: %url'|i18n( 'design/standard/mail',, hash( '%url', $fp_url ) )
         $fp_outro = array( 'If you did not ask for this, you can ignore this mail: your password stays as it is.'|i18n( 'design/standard/user/forgotpassword' ) )}
    {if $fp_minutes|gt( 0 )}
        {set $fp_notice = 'The link works only once and only for %1 minutes.'|i18n( 'design/standard/user/forgotpassword',, array( $fp_minutes ) )}
    {/if}
{else}
    {set $fp_title = 'Your new password'|i18n( 'design/standard/user/forgotpassword' )
         $fp_intro = 'Your password on %site was reset. Sign in with this new password, then change it to one of your own.'|i18n( 'design/standard/user/forgotpassword',, hash( '%site', $fp_site ) )
         $fp_code = first_set( $password, '' )
         $fp_code_label = 'New password'|i18n( 'design/standard/user/forgotpassword' )}
    {set $fp_buttons = array( hash( 'label', 'Sign in'|i18n( 'design/standard/user/register' ), 'url', $fp_login, 'kind', 'primary' ) )
         $fp_note = 'If the button does not work, copy this address into your browser: %url'|i18n( 'design/standard/mail',, hash( '%url', $fp_login ) )
         $fp_outro = array( 'If you did not reset your password, sign in with this one and change it at once.'|i18n( 'design/standard/user/forgotpassword' ) )}
{/if}
{set-block scope=root variable=subject}{cond( $fp_link, 'Reset your password for %site'|i18n( 'design/standard/user/forgotpassword',, hash( '%site', $fp_site ) ),
                                              'Your new password for %site'|i18n( 'design/standard/user/forgotpassword',, hash( '%site', $fp_site ) ) )}{/set-block}
{set-block scope=root variable=content_type}text/html{/set-block}
{set-block scope=root variable=body_text}{include uri='design:mail/layout_text.tpl'
    mail_title=$fp_title mail_intro=$fp_intro mail_code=$fp_code mail_code_label=$fp_code_label mail_rows=$fp_rows
    mail_notice=$fp_notice mail_buttons=$fp_buttons mail_outro=$fp_outro mail_site_name=$fp_site}{/set-block}
{include uri='design:mail/layout.tpl'
    mail_title=$fp_title mail_intro=$fp_intro mail_code=$fp_code mail_code_label=$fp_code_label mail_rows=$fp_rows
    mail_notice=$fp_notice mail_buttons=$fp_buttons mail_links_note=$fp_note mail_outro=$fp_outro mail_site_name=$fp_site
    mail_preheader=$fp_intro}
{undef $fp_site $fp_link $fp_minutes $fp_url $fp_login $fp_title $fp_intro $fp_code $fp_code_label $fp_notice $fp_note
       $fp_buttons $fp_outro $fp_rows}
