{* DO NOT EDIT THIS FILE! Use an override template instead. *}
{*
    The order confirmation (eZDefaultConfirmOrderHandler), sent to the customer and a copy to site.ini [MailSettings]
    AdminEmail. Category orders. Variables: order (eZOrder).
    Sets subject, content_type (text/html) and body_text (the plain-text part).
    The look is design:mail/layout.tpl (HTML) and design:mail/layout_text.tpl (text); this template only passes text
    and links, which the layout washes. design/base/templates/shop/orderemail.tpl is the same file.
*}
{def $currency = fetch( 'shop', 'currency', hash( 'code', $order.productcollection.currency_code ) )
     $locale = false()
     $symbol = false()
     $oe_title = concat( "Order"|i18n( "design/standard/shop" ), ': ', $order.order_nr )
     $oe_customer = ''
     $oe_rows = array()
     $oe_paragraphs = array()
     $oe_buttons = array()
     $oe_receipt = ''
     $oe_note = ''}
{if $currency}
    {set $locale = $currency.locale
         $symbol = $currency.symbol}
{/if}
{set-block variable=oe_customer}{shop_account_view_gui view=ascii order=$order}{/set-block}
{foreach $order.product_items as $oe_item}
    {set $oe_rows = $oe_rows|append( hash( 'label', concat( $oe_item.item_count, ' x ', $oe_item.object_name ),
                                           'value', concat( $oe_item.price_inc_vat|l10n( 'currency', $locale, $symbol ), ' / ', $oe_item.total_price_inc_vat|l10n( 'currency', $locale, $symbol ) ) ) )}
{/foreach}
{set $oe_rows = $oe_rows|append( hash( 'label', "Subtotal of items"|i18n( "design/standard/shop" ), 'value', $order.product_total_inc_vat|l10n( 'currency', $locale, $symbol ) ) )}
{foreach $order.order_items as $oe_order_item}
    {set $oe_rows = $oe_rows|append( hash( 'label', $oe_order_item.description, 'value', $oe_order_item.price_inc_vat|l10n( 'currency', $locale, $symbol ) ) )}
{/foreach}
{set $oe_rows = $oe_rows|append( hash( 'label', "Order total"|i18n( "design/standard/shop" ), 'value', $order.total_inc_vat|l10n( 'currency', $locale, $symbol ) ) )}
{if $oe_customer|trim|ne( '' )}
    {set $oe_paragraphs = array( $oe_customer|trim )}
{/if}
{if $order.link_url|begins_with( '/shop/orderreceipt/' )}
    {set $oe_receipt = $order.link_url|ezurl( 'no', 'full' )}
    {if $oe_receipt|begins_with( 'http://' )}{set $oe_receipt = concat( 'https://', $oe_receipt|extract( 7 ) )}{/if}
    {set $oe_buttons = array( hash( 'label', 'View your receipt'|i18n( 'design/standard/shop' ), 'url', $oe_receipt, 'kind', 'primary' ) )
         $oe_note = concat( "Your receipt (sign in to view it; the address does not expire)"|i18n( "design/standard/shop" ), ': ', $oe_receipt )}
{/if}
{set-block scope=root variable=subject}{"Order"|i18n("design/standard/shop")}: {$order.order_nr}{/set-block}
{set-block scope=root variable=content_type}text/html{/set-block}
{set-block scope=root variable=body_text}{include uri='design:mail/layout_text.tpl'
    mail_title=$oe_title mail_rows=$oe_rows mail_paragraphs=$oe_paragraphs mail_buttons=$oe_buttons}{/set-block}
{include uri='design:mail/layout.tpl'
    mail_title=$oe_title mail_rows=$oe_rows mail_paragraphs=$oe_paragraphs mail_buttons=$oe_buttons mail_links_note=$oe_note}
{undef $currency $locale $symbol $oe_title $oe_customer $oe_rows $oe_paragraphs $oe_buttons $oe_receipt $oe_note}
