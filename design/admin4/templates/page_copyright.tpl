{* DO NOT EDIT THIS FILE! Use an override template instead. *}
{* The Help center (exphelp/dashboard), the start page of the help, from every page of the administration; for users
   with exphelp/read while the help is switched on (the footer's cache block is keyed by the user's roles) *}
{if and( ezini( 'HelpSettings', 'Enabled', 'exphelp.ini' )|eq( 'true' ), fetch( 'user', 'has_access_to', hash( 'module', 'exphelp', 'function', 'read' ) ) )}
<p class="a4-footer-help"><a href={'/exphelp/dashboard'|ezurl}><span class="a4-icon a4-bi-question-circle" aria-hidden="true"></span>{'Help center'|i18n( 'design/admin/page_copyright' )|wash}</a></p>
{/if}
<p>
{'Powered by <span class="edition-info">%edition</span>. For more information see <a href=%about_link>ezinfo/about</a>.'|i18n( 'design/admin/page_copyright',, hash( '%edition', fetch( 'setup', 'edition' ), '%about_link', "/ezinfo/about"|ezurl ) )}</p>
<p>
{'<a href="%ezpublish_link">Exponential</a> Copyright &copy; 1998-2026 <a href="%ez_link">7x</a> and others.'|i18n( 'design/admin/page_copyright',, hash( '%ezpublish_link', 'https://se7enx.com/Exponential', '%ez_link', 'https://se7enx.com' ) )}
</p>
{* The evaluate / community links: off by default in admin4. Shown when a template sets $show_community_links
   to true() before this one, or design.ini [AdminDesignSettings] ShowCommunityLinks=enabled. *}
{if is_unset( $show_community_links )}
    {def $show_community_links = false()}
    {if ezini_hasvariable( 'AdminDesignSettings', 'ShowCommunityLinks', 'design.ini' )}
        {set $show_community_links = eq( ezini( 'AdminDesignSettings', 'ShowCommunityLinks', 'design.ini' ), 'enabled' )}
    {/if}
{/if}
{if $show_community_links}
<p>
{* The share link names the release to signed-in users only, as the header does (also under layouts that define no $current_user) *}
{'<a href="%evaluate_link">Evaluate Exponential (From 7x)</a> - <a href="%share_link">Become a member of the Exponential Community, get support and contribute</a>.'|i18n( 'design/admin/page_copyright',, hash( '%evaluate_link', 'https://se7enx.com', '%share_link', concat( 'https://share.exponential.earth?utm_content=Exponential+Community+Project', fetch( 'user', 'current_user' ).is_logged_in|choose( '', concat( '+', fetch( 'setup', 'version' ) ) ) , '&utm_source=Exponential+Community+Project+Dashboard&utm_medium=Exponential+Community+Project+Dashboard&utm_campaign=Exponential+Community+Project+Dashboard' ) ) )}
</p>
{/if}
