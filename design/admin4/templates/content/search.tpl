{* DO NOT EDIT THIS FILE! Use an override template instead. *}
{let search=false()}
{default search_requested=true() search_text_shortened=false()}
{section show=and( $use_template_search, $search_requested )}
    {* the view's SearchPageLimit (1 to 5, as in the advanced search), never more than the search gives *}
    {set page_limit=10}
    {switch match=first_set( $search_page_limit, 2 )}
    {case match=1}{set page_limit=5}{/case}
    {case match=3}{set page_limit=20}{/case}
    {case match=4}{set page_limit=30}{/case}
    {case match=5}{set page_limit=50}{/case}
    {case/}
    {/switch}
    {set page_limit=min( $page_limit, ezini( 'SearchSettings', 'MaximumSearchLimit' ) )}
    {* Without words there is nothing to look for: a search engine that allows an empty search (eZ Find's
       AllowEmptySearch) would list the whole index. *}
    {if $search_text|trim|ne( '' )}
    {set search=fetch(content,search,
                      hash(text,$search_text,
                           section_id,$search_section_id,
                           subtree_array,$search_subtree_array,
                           sort_by,array('modified',false()),
                           offset,$view_parameters.offset,
                           limit,$page_limit))}
    {/if}
    {if $search}
    {set search_result=$search['SearchResult']}
    {set search_count=$search['SearchCount']}
    {set stop_word_array=$search['StopWordArray']}
    {set search_data=$search}
    {/if}
{/section}

<form action={'/content/search/'|ezurl} method="get" role="search" aria-label="{'Search'|i18n( 'design/admin/content/search' )|wash}">

<div class="context-block content-search">
{* DESIGN: Header START *}<div class="box-header"><div class="box-ml">
<h1 class="context-title">{'Search'|i18n( 'design/admin/content/search' )}</h1>

{* DESIGN: Mainline *}<div class="header-mainline"></div>

{* DESIGN: Header END *}</div></div>

{* DESIGN: Content START *}<div class="box-bc"><div class="box-ml"><div class="box-content">

<div class="context-attributes">

<div class="block">
    <label for="Search">{'Search for'|i18n( 'design/admin/content/search' )}</label>
    <input class="halfbox" type="search" name="SearchText" id="Search" value="{$search_text|wash}" />
    <input class="button"  name="SearchButton" type="submit" value="{'Search'|i18n( 'design/admin/content/search' )}" />
</div>

{if $search_text_shortened}
<p class="a4-notice is-info" role="status">{'The search text was too long and was shortened.'|i18n( 'design/admin/content/search' )}</p>
{/if}

{* Where to search. A new search from this form keeps the section and the locations of the last one *}
<div class="block">
<label for="ezcontent_search_section_id">{'In'|i18n( 'design/admin/content/search' )}:</label>
<select id="ezcontent_search_section_id" name="SectionID">
<option value="-1">{'Any section'|i18n( 'design/admin/content/search' )}</option>
{foreach fetch( 'section', 'list' ) as $search_section}
<option value="{$search_section.id}"{if eq( $search_section.id, $search_section_id )} selected="selected"{/if}>{$search_section.name|wash}</option>
{/foreach}
</select>
</div>

{if first_set( $search_page_limit, 2 )|ne( 2 )}<input type="hidden" name="SearchPageLimit" value="{$search_page_limit|wash}" />{/if}

{if and(count($search_subtree_array)|eq(1),$search_subtree_array.0|ne(1))}
<fieldset class="block">
<legend>{'Where'|i18n( 'design/admin/pagelayout' )}</legend>
<label><input type="radio" name="SubTreeArray" value="1" />{'All content'|i18n('design/admin/content/search')}</label>
{def $search_node = fetch('content', 'node', hash( 'node_id', $search_subtree_array.0 ))}
<label><input type="radio" name="SubTreeArray" value="{$search_subtree_array.0|wash}" checked="checked" />{'The same location'|i18n('design/admin/content/search')} ({$search_node.name|wash})</label>
{undef $search_node}
</fieldset>
{elseif count( $search_subtree_array )|gt( 1 )}
{foreach $search_subtree_array as $search_subtree_id}
<input type="hidden" name="SubTreeArray[]" value="{$search_subtree_id|wash}" />
{/foreach}
{/if}

<div class="block">
    {let adv_url=concat( '/content/advancedsearch/', $search_text|count|gt( 0 )|choose('', concat( '?SearchText=', $search_text|urlencode ) ) )|ezurl}
    {'For more options try the %1Advanced search%2.'|i18n( 'design/admin/content/search', 'The parameters are link start and end tags.', array( concat( '<a href=', $adv_url, '>' ), '</a>' ) )}
    {/let}
</div>

{* Excluded words. *}
{section show=$stop_word_array}
<p>
{'The following words were excluded from the search'|i18n( 'design/admin/content/search' )}:
{section name=StopWord loop=$stop_word_array}
    {$StopWord:item.word|wash}
    {delimiter}, {/delimiter}
{/section}
</p>
{/section}

{* Nothing searched for yet, a search that failed, or no matches. *}
{* the search engine's report: from the view, or from the fetch above when the template searches *}
{def $search_failed = false()
     $search_info = false()}
{if is_set( $search_extras )}{set $search_info = $search_extras}{elseif $search}{if is_set( $search.SearchExtras )}{set $search_info = $search.SearchExtras}{/if}{/if}
{if is_object( $search_info )}{if $search_info.error}{set $search_failed = true()}{/if}{/if}
{if $search_failed}
<div class="a4-notice is-bad" role="alert"><p>{'The search could not be run. Try fewer or simpler words, or search again later.'|i18n( 'design/admin/content/search' )}</p></div>
{elseif and( $search_count|not, $search_text|trim|eq( '' ) )}
<p>{'Type the words to search for.'|i18n( 'design/admin/content/search' )}</p>
{elseif $search_count|not}
<h2>{'No results were found while searching for <%1>'|i18n( 'design/admin/content/search',, array( $search_text ) )|wash}</h2>
    <p>{'Search tips'|i18n( 'design/admin/content/search' )}</p>
    <ul>
        <li>{'Check spelling of keywords.'|i18n( 'design/admin/content/search' )}</li>
        <li>{'Try changing some keywords e.g. &quot;car&quot; instead of &quot;cars&quot;.'|i18n( 'design/admin/content/search' )}</li>
        <li>{'Try more general keywords.'|i18n( 'design/admin/content/search' )}</li>
        <li>{'Fewer keywords result in more matches. Try reducing keywords until you get a result.'|i18n( 'design/admin/content/search' )}</li>
    </ul>
{/if}

</div>
{* DESIGN: Content END *}</div></div></div>

</div>

{* Search result. *}
{if $search_count}
<div class="context-block">
{* DESIGN: Header START *}<div class="box-header"><div class="box-ml">
<h2 class="context-title">{if $search_text|trim|eq( '' )}{'%count matches'|i18n( 'design/admin/content/search',, hash( '%count', $search_count ) )|wash}{else}{'Search for <%1> returned %2 matches'|i18n( 'design/admin/content/search',, array( $search_text, $search_count ) )|wash}{/if}</h2>



{* DESIGN: Header END *}</div></div>

{* DESIGN: Content START *}<div class="box-bc"><div class="box-ml"><div class="box-content">

{* the search's address without the page: the pages below, and the way back from a page past the last *}
{def $search_page_suffix = concat( '?SearchText=', $search_text|urlencode, $search_timestamp|gt( 0 )|choose( '', concat( '&SearchTimestamp=', $search_timestamp ) ), $search_subtree_array|count|gt( 0 )|choose( '', concat( '&', 'SubTreeArray[]'|urlencode, '=', $search_subtree_array|implode( concat( '&', 'SubTreeArray[]'|urlencode, '=' ) ) ) ), $search_section_id|gt( 0 )|choose( '', concat( '&SectionID=', $search_section_id ) ), first_set( $search_page_limit, 2 )|eq( 2 )|choose( concat( '&SearchPageLimit=', first_set( $search_page_limit, 2 )|urlencode ), '' ) )}
{if $search_result}
{include name=Result uri='design:content/searchresult.tpl' search_result=$search_result}
{else}
{* A page past the last one ((offset) beyond the matches, an old link or a list that shrank): no empty table under
   the count, but what happened and the way to the first page *}
<p class="a4-notice is-info" role="status">{'There are no matches on this page.'|i18n( 'design/admin/content/search' )} <a href={concat( '/content/search', $search_page_suffix )|ezurl}>{'Go to the first page'|i18n( 'design/admin/content/search' )}</a></p>
{/if}

<div class="context-toolbar">
{include name=Navigator
         uri='design:navigator/google.tpl'
         page_uri='/content/search'
         page_uri_suffix=$search_page_suffix
         item_count=$search_count
         view_parameters=$view_parameters
         item_limit=$page_limit}
</div>
{* DESIGN: Content END *}</div></div></div>
</div>
{undef $search_page_suffix}
{/if}

</form>
{undef $search_failed $search_info}
{/default}
{/let}
