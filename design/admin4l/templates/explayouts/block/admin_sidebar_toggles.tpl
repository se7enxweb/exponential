{* Admin block (explayouts). Markup copied from admin4 page_topmenu.tpl lines, keep in step with it. *}
    {* The phone-width menu button; ezadmin_menubar.js toggles the menu, aria-expanded and the keys. *}
    <div class="navbar-icon" role="button" tabindex="0" aria-expanded="false" aria-controls="a4-navbar-menu" aria-label="{'Menu'|i18n( 'design/admin/pagelayout' )|wash}"><span aria-hidden="true">&#9776;</span></div>
    <!-- begin::Sidebar Controls -->
        <div class="sidebar-controls">
            <button type="button" class="sidebar-control left" aria-controls="leftmenu" aria-expanded="false" aria-label="{'Show or hide the left sidebar'|i18n( 'design/admin/pagelayout' )|wash}" title="{'Show or hide the left sidebar'|i18n( 'design/admin/pagelayout' )|wash}">
                <span class="a4-icon a4-bi-chevron-right" aria-hidden="true"></span>
            </button>
            <button type="button" class="sidebar-control right" aria-controls="rightmenu" aria-expanded="false" aria-label="{'Show or hide the right sidebar'|i18n( 'design/admin/pagelayout' )|wash}" title="{'Show or hide the right sidebar'|i18n( 'design/admin/pagelayout' )|wash}">
                <span class="a4-icon a4-bi-chevron-right" aria-hidden="true"></span>
            </button>
        </div>
    <!-- end::Sidebar Controls -->
