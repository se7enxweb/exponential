{
    "name": "se7enxweb/exponential-devtools",
    "description": "Development tools of Exponential: code style check and static analysis. Installed into .devtools/, never into vendor/.",
    "license": "GPL-2.0-or-later",
    "require": {
        "phpcompatibility/php-compatibility": "^10.0@alpha",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "config": {
        "vendor-dir": ".devtools/vendor",
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
