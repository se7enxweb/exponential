{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/se7enxweb/exponential/main/share/migration/schema/exp-migration-status-1.json",
  "title": "Exponential migration status (exp-migration-status/1)",
  "description": "migrations/status/<environment>.json: the migrations an installation of one environment has applied and its latest runs, mirrored from the tables exp_migration and exp_migration_run into the migrations repository. Holds no secrets and no personal data: no user names, no messages.",
  "type": "object",
  "required": [ "schema", "environment", "engine", "updated_at", "summary", "migrations", "runs" ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "exp-migration-status/1" },
    "environment": { "$ref": "#/$defs/environment" },
    "engine": { "type": "string", "pattern": "^[a-z0-9_]{0,30}$" },
    "updated_at": { "$ref": "#/$defs/time" },
    "summary": {
      "type": "object",
      "required": [ "total" ],
      "propertyNames": { "pattern": "^[a-z][a-z-]{0,19}$" },
      "additionalProperties": { "type": "integer" }
    },
    "migrations": { "type": "array", "items": { "$ref": "#/$defs/migration" } },
    "runs": { "type": "array", "items": { "$ref": "#/$defs/run" } }
  },
  "$defs": {
    "environment": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,49}$" },
    "time": {
      "description": "UTC, ISO 8601 with seconds; null when not known",
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
      ]
    },
    "text": { "type": "string", "maxLength": 255 },
    "migration": {
      "type": "object",
      "required": [ "source", "id", "state", "file", "checksum", "stage", "version", "run_id", "started_at", "finished_at", "duration_ms", "caption_id", "revision" ],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1, "maxLength": 100 },
        "id": { "type": "string", "minLength": 1, "maxLength": 150 },
        "state": { "type": "string", "pattern": "^[a-z][a-z-]{0,19}$" },
        "file": { "$ref": "#/$defs/text" },
        "checksum": { "type": "string", "pattern": "^([0-9a-f]{64})?$" },
        "stage": { "type": "string", "maxLength": 20 },
        "version": { "type": "string", "maxLength": 30 },
        "run_id": { "type": "string", "maxLength": 64 },
        "started_at": { "$ref": "#/$defs/time" },
        "finished_at": { "$ref": "#/$defs/time" },
        "duration_ms": { "type": "integer" },
        "caption_id": { "type": "string", "maxLength": 150 },
        "revision": { "type": "string", "maxLength": 64 }
      }
    },
    "run": {
      "type": "object",
      "required": [ "run_id", "state", "started_at", "finished_at", "caption_pre", "caption_post", "commit", "tag", "push_state", "log" ],
      "additionalProperties": false,
      "properties": {
        "run_id": { "type": "string", "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,63}$" },
        "state": { "type": "string", "pattern": "^[a-z][a-z-]{0,19}$" },
        "started_at": { "$ref": "#/$defs/time" },
        "finished_at": { "$ref": "#/$defs/time" },
        "caption_pre": { "type": "string", "maxLength": 150 },
        "caption_post": { "type": "string", "maxLength": 150 },
        "commit": { "type": "string", "maxLength": 64 },
        "tag": { "type": "string", "maxLength": 150 },
        "push_state": { "type": "string", "maxLength": 20 },
        "log": { "$ref": "#/$defs/text" }
      }
    }
  }
}
