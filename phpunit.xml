<?xml version="1.0" encoding="UTF-8"?>
<!--
  phpunit.xml — Exponential 6.0.13 / eZ Publish Legacy PHPUnit 10 configuration.

  Added in 6.0.13-alpha2 to fix complete test suite failure caused by missing
  bootstrap when upgrading from PHPUnit 3.7 to PHPUnit 10.0.

  See doc/eng-us/bc/6.0/phpunitvXXXX.md for full explanation of what broke and why.

  Usage:
    php vendor/bin/phpunit                              # run all suites
    php vendor/bin/phpunit - -testsuite security        # security tests only
    php vendor/bin/phpunit - -testsuite kernel-classes  # kernel class tests only
    php vendor/bin/phpunit - -list-tests                # list all test methods
    php vendor/bin/phpunit - -list-test-files           # list all test files
    php tests/runtests.php - -dsn=mysql://u:p@h/db - -db-per-test
-->
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.0/phpunit.xsd"
    bootstrap="tests/bootstrap.php"
    colors="true"
    displayDetailsOnIncompleteTests="true"
    displayDetailsOnSkippedTests="true"
    displayDetailsOnTestsThatTriggerDeprecations="true"
    failOnEmptyTestSuite="false"
    cacheDirectory=".phpunit.cache"
    failOnPhpunitWarning="false"
>

    <testsuites>

        <testsuite name="security">
            <directory suffix="Test.php">tests/tests/kernel/classes/security</directory>
        </testsuite>

        <!-- run by the verification after an upgrade (exp:upgrade:verify with after): fast, no database, no network -->
        <testsuite name="upgrade-smoke">
            <directory suffix="Test.php">tests/tests/kernel/classes/upgrade</directory>
            <file>tests/tests/kernel/classes/help/expHelpSearchContractTest.php</file>
            <file>tests/tests/kernel/classes/httpcache/ezpHttpCacheContractTest.php</file>
        </testsuite>

        <testsuite name="kernel-classes">
            <directory suffix="Test.php">tests/tests/kernel/classes</directory>
            <!-- the template operators of kernel/common, called directly; no database -->
            <directory suffix="Test.php">tests/tests/kernel/common</directory>
            <!-- the error module's view (kernel/error): headers of error pages; no database -->
            <directory suffix="Test.php">tests/tests/kernel/error</directory>
            <exclude>tests/tests/kernel/classes/security</exclude>
        </testsuite>

        <testsuite name="kernel-content">
            <directory suffix="Test.php">tests/tests/kernel/content</directory>
        </testsuite>

        <testsuite name="kernel-datatypes">
            <directory suffix="Test.php">tests/tests/kernel/datatypes</directory>
        </testsuite>

        <!-- the built-in search engine (kernel/search); the database tests roll back what they write -->
        <testsuite name="kernel-search">
            <directory suffix="Test.php">tests/tests/kernel/search</directory>
        </testsuite>

        <!-- kernel/private (REST, console commands, kernel helpers); the older *_test.php files there are not run -->
        <testsuite name="kernel-private">
            <directory suffix="Test.php">tests/tests/kernel/private</directory>
        </testsuite>

        <!-- the content finder (doc/eng-us/features/6.0/content-finder.md): the input tests need nothing; the database
             tests write, so they run only in a throwaway copy named by EXP_CONTENTFINDER_SANDBOX and skip elsewhere -->
        <testsuite name="kernel-contentfinder">
            <directory suffix="Test.php">tests/tests/kernel/contentfinder</directory>
        </testsuite>

        <!-- the content checks (doc/eng-us/features/6.0/content-checks.md): the query tests need no database; the database
             tests write, so they run only in a throwaway installation named by EXP_CONTENTCHECK_SANDBOX and skip elsewhere -->
        <testsuite name="kernel-contentcheck">
            <directory suffix="Test.php">tests/tests/kernel/contentcheck</directory>
        </testsuite>

        <!-- the log viewer (doc/eng-us/features/6.0/log-viewer.md): parser, tailing by offset, masking, path safety, the
             bounded search and the actions, on synthetic files in the temporary directory; no database -->
        <testsuite name="kernel-logviewer">
            <directory suffix="Test.php">tests/tests/kernel/logviewer</directory>
        </testsuite>

        <!-- the request logs (doc/eng-us/features/6.0/request-logs.md): 404.log, the request classifier and security.log,
             one line per request whichever way it ends; settings given to the classes, files below var/tmp; no
             database -->
        <testsuite name="kernel-requestlog">
            <directory suffix="Test.php">tests/tests/kernel/requestlog</directory>
            <directory suffix="Test.php">tests/tests/kernel/requestclassifier</directory>
        </testsuite>

        <testsuite name="lib">
            <directory suffix="Test.php">tests/tests/lib</directory>
            <exclude>tests/tests/lib/ezdb/mongodb</exclude>
        </testsuite>

        <!--
          MongoDB adapter unit tests — no live DB required.
          Run: php vendor/bin/phpunit - -testsuite mongodb
        -->
        <testsuite name="mongodb">
            <file>tests/tests/lib/ezdb/mongodb/expMongoDBAdapterTest.php</file>
            <file>tests/tests/lib/ezdb/mongodb/expMongoDBDeclaredDefaultTest.php</file>
        </testsuite>

        <!--
          MongoDB + MySQL live integration tests — require running servers.
          Run: php vendor/bin/phpunit - -testsuite mongodb-live
        -->
        <testsuite name="mongodb-live">
            <file>tests/tests/lib/ezdb/mongodb/expMongoDBIntegrationTest.php</file>
        </testsuite>

        <!--
          cjw_newsletter: live-database tests (admin siteaccess, throwaway nltest-*@example.invalid data, mail written
          by the file transport into var/tmp, never a real send, never a test database).
          Run: php vendor/bin/phpunit - -testsuite cjw_newsletter
        -->
        <testsuite name="cjw_newsletter">
            <directory suffix="Test.php">tests/tests/extension/cjw_newsletter</directory>
        </testsuite>

        <!--
          Admin layouts (admin4l): resolver, rules, separation, cache keys, block definitions. Live database and
          settings of the admin siteaccess, nothing written but the resolver's own cache generation.
          Run: php vendor/bin/phpunit - -testsuite explayouts_admin
        -->
        <testsuite name="explayouts_admin">
            <directory suffix="Test.php">tests/tests/extension/explayouts_admin</directory>
        </testsuite>

        <!--
          ezjscore: the ezjscore/call server, with stand-in server functions. No kernel, database or siteaccess.
          Run: php vendor/bin/phpunit - -testsuite ezjscore
        -->
        <testsuite name="ezjscore">
            <directory suffix="Test.php">tests/tests/extension/ezjscore</directory>
        </testsuite>

        <!--
          ezmultiupload: the server side of the upload page (input checks, form token, permission pre-check,
          duplicate check) and its ZIP import, with nodes and classes held in memory. No database or siteaccess.
          Run: php vendor/bin/phpunit - -testsuite ezmultiupload
        -->
        <testsuite name="ezmultiupload">
            <directory suffix="Test.php">tests/tests/extension/ezmultiupload</directory>
        </testsuite>

        <!--
          ezprestapi: the extension serves REST API v1 and v2 without the deprecated ezprestapiprovider (no class of
          the provider named, constants and route actions declared, rest.ini maps to its own provider). Reads the
          extension's files only; no kernel, database or siteaccess.
          Run: php vendor/bin/phpunit - -testsuite ezprestapi
        -->
        <testsuite name="ezprestapi">
            <directory suffix="Test.php">tests/tests/extension/ezprestapi</directory>
        </testsuite>

        <!--
          expservices: the service layer called like the ezjscore router does (content, users, commerce, community,
          media, misc, core). Live database of the admin siteaccess, throwaway rows the tests remove again, never a
          test database. Without an installed site (CI) every class is skipped by ezpLiveInstallation::requireOrSkip().
          Run: php vendor/bin/phpunit - -testsuite expservices
        -->
        <testsuite name="expservices">
            <directory suffix="Test.php">tests/tests/extension/expservices</directory>
        </testsuite>

        <!--
          ezoe: the online editor's engine registry, configuration, views, upload rules and URL fetcher. Live
          installation like expservices; skipped without one.
          Run: php vendor/bin/phpunit - -testsuite ezoe
        -->
        <testsuite name="ezoe">
            <directory suffix="Test.php">tests/tests/extension/ezoe</directory>
        </testsuite>

        <!--
          expimageeditor: the checks of the image editor's save view (permissions, file type, kind, size, SVG) without a
          database, and its design files (texts, icons, no inline code) read as files.
          Run: php vendor/bin/phpunit - -testsuite expimageeditor
        -->
        <testsuite name="expimageeditor">
            <directory suffix="Test.php">extension/expimageeditor/tests/phpunit/unit</directory>
        </testsuite>

        <!--
          maps: how the map templates of ezgmaplocation, ezflow and cjw_themes_jumper escape a location's address,
          and the datatype's fromString(). No database; a test whose extension is not installed is skipped.
          Run: php vendor/bin/phpunit - -testsuite maps
        -->
        <testsuite name="maps">
            <directory suffix="Test.php">tests/tests/extension/maps</directory>
        </testsuite>

        <!--
          admin-extensions: the admin templates and stylesheets of git_manager, ezupdate and sevenx_dse follow the admin
          design rules (no inline CSS or scripts, tokens only, admin4 menus with the width switch), and ezflow's edit
          script (in node, against tests/tests/design/js/mini_dom.js). Reads files only; a test whose extension is not
          installed is skipped.
          Run: php vendor/bin/phpunit - -testsuite admin-extensions
        -->
        <testsuite name="admin-extensions">
            <file>tests/tests/extension/git_manager/GitManagerAdminStylingTest.php</file>
            <file>tests/tests/extension/git_manager/GitManagerLogPagingTest.php</file>
            <file>tests/tests/extension/ezupdate/ezUpdateAdminStylingTest.php</file>
            <file>tests/tests/extension/sevenx_dse/SevenxDseAdminStylingTest.php</file>
            <file>tests/tests/extension/sevenx_dse/SevenxDseAdminNeoViewTest.php</file>
            <file>tests/tests/extension/sevenx_dse/SevenxDseAdminNeoWorkerStateTest.php</file>
            <file>tests/tests/extension/ezflow/ezflowEditScriptTest.php</file>
        </testsuite>

        <!--
          quality: the sniffs of the code style check (bin/phpcs/). Needs the development tools (make devtools).
          Run: php vendor/bin/phpunit - -testsuite quality
        -->
        <testsuite name="quality">
            <directory suffix="Test.php">tests/tests/bin</directory>
        </testsuite>

        <!--
          design: the rules of the admin designs read from the files (no inline CSS in the templates, tokens only in
          the module stylesheets, a dark value for every colour token). No database. doc/eng-us/bc/6.0/admin4-styling.md
          Run: php vendor/bin/phpunit - -testsuite design
        -->
        <testsuite name="design">
            <directory suffix="Test.php">tests/tests/design</directory>
        </testsuite>

    </testsuites>

    <groups>
        <exclude>
            <!--
              Tests tagged @group database require a database server. Each test
              class (ezpDatabaseTestCase) gets a throwaway database exp_test_*
              with the kernel schema and the clean data, dropped again
              (tests/toolkit/ezpthrowawaydatabase.php). It needs an account with
              CREATE and DROP: EXP_TEST_DB_USER / EXP_TEST_DB_PASSWORD (default:
              the database settings of EXP_TEST_SITEACCESS, else DefaultAccess);
              without one the tests are skipped with the reason.
            -->
            <group>database</group>
            <group>mail-live</group>
            <!--
              Tests tagged @group mongodb-live require running MongoDB + MySQL.
              Run them separately:
                php vendor/bin/phpunit - -testsuite mongodb-live
            -->
            <group>mongodb-live</group>
            <group>network-live</group>
        </exclude>
    </groups>

    <source>
        <include>
            <directory suffix=".php">lib</directory>
            <directory suffix=".php">kernel</directory>
        </include>
    </source>

    <php>
        <env name="EZP_TEST_ENVIRONMENT" value="1"/>
        <!-- A runaway test stops with PHP's "Allowed memory size exhausted" naming the test run,
             instead of the runner killing the whole job (exit code 137, no message). The suite peaks
             at about 70 MB. -->
        <ini name="memory_limit" value="1G"/>
        <!-- PHP_INI_SCAN_DIR is set at runtime by tests/bootstrap.php so PHPUnit's
             isolated-process children can find tests/xdebug.ini without hardcoding
             the repository path. -->
    </php>

</phpunit>
