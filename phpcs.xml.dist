<?xml version="1.0"?>
<!--
    Code style of Exponential (6.0.15 standard).

    These rules describe how the existing kernel and lib code is written; each
    one was measured against the code before it was added. They are checked on
    changed files only (git hook, make phpcs, CI), never on the whole tree, so
    old code is not reformatted.

    Run: make phpcs  or  .devtools/vendor/bin/phpcs FILE...
-->
<ruleset name="Exponential">
    <description>Exponential 6.0.15 code style</description>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/.devtools/*</exclude-pattern>
    <exclude-pattern>*/var/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <!-- Arrays are written array( ... ), never [ ... ] -->
    <rule ref="Generic.Arrays.DisallowShortArraySyntax"/>

    <!-- One space inside the parentheses of if, foreach, while, switch ...: if ( $a ) -->
    <rule ref="PSR2.ControlStructures.ControlStructureSpacing">
        <properties>
            <property name="requiredSpacesAfterOpen" value="1"/>
            <property name="requiredSpacesBeforeClose" value="1"/>
        </properties>
    </rule>

    <!-- One space inside the parentheses of a function call: foo( $a, $b ), no space before "(".
         The layout of calls over several lines is free. -->
    <rule ref="PEAR.Functions.FunctionCallSignature">
        <properties>
            <property name="requiredSpacesAfterOpen" value="1"/>
            <property name="requiredSpacesBeforeClose" value="1"/>
            <property name="allowMultipleArguments" value="true"/>
        </properties>
        <exclude name="PEAR.Functions.FunctionCallSignature.Indent"/>
        <exclude name="PEAR.Functions.FunctionCallSignature.CloseBracketLine"/>
        <exclude name="PEAR.Functions.FunctionCallSignature.ContentAfterOpenBracket"/>
        <exclude name="PEAR.Functions.FunctionCallSignature.OpeningIndent"/>
        <exclude name="PEAR.Functions.FunctionCallSignature.MultipleArguments"/>
        <exclude name="PEAR.Functions.FunctionCallSignature.EmptyLine"/>
    </rule>

    <!-- One space inside the parentheses of a function declaration: function foo( $a, $b ) -->
    <rule ref="Squiz.Functions.FunctionDeclarationArgumentSpacing">
        <properties>
            <property name="requiredSpacesAfterOpen" value="1"/>
            <property name="requiredSpacesBeforeClose" value="1"/>
            <property name="equalsSpacing" value="1"/>
        </properties>
    </rule>

    <!-- The opening brace of a function or method goes on its own line -->
    <rule ref="Generic.Functions.OpeningFunctionBraceBsdAllman"/>

    <!-- No space after the not operator: !$a -->
    <rule ref="Generic.Formatting.SpaceAfterNot">
        <properties>
            <property name="spacing" value="0"/>
        </properties>
    </rule>

    <!-- true, false, null and keywords in lower case -->
    <rule ref="Generic.PHP.LowerCaseConstant"/>
    <rule ref="Generic.PHP.LowerCaseKeyword"/>

    <!-- Full <?php tags, Unix line endings, spaces instead of tabs, no trailing spaces -->
    <rule ref="Generic.PHP.DisallowShortOpenTag"/>
    <rule ref="Generic.Files.LineEndings"/>
    <rule ref="Generic.WhiteSpace.DisallowTabIndent"/>
    <rule ref="Squiz.WhiteSpace.SuperfluousWhitespace.EndLine"/>

    <!-- Functions removed from PHP or replaced in Exponential -->
    <rule ref="Generic.PHP.ForbiddenFunctions">
        <properties>
            <property name="forbiddenFunctions" type="array">
                <element key="each" value="foreach"/>
                <element key="create_function" value="a closure"/>
                <element key="split" value="explode or preg_split"/>
                <element key="ereg" value="preg_match"/>
                <element key="eregi" value="preg_match"/>
                <element key="ereg_replace" value="preg_replace"/>
                <element key="mysql_query" value="eZDB"/>
                <element key="mysql_connect" value="eZDB"/>
                <element key="sizeof" value="count"/>
                <element key="delete" value="unset"/>
            </property>
        </properties>
    </rule>
    <rule ref="Generic.Functions.CallTimePassByReference"/>

    <!-- No type declarations, as in the 6.0.15 code: no declare( strict_types=1 ),
         no parameter, return, property or constant types. Tests may declare the
         ": void" PHPUnit requires. The sniff is in bin/phpcs/Exponential/. -->
    <rule ref="./bin/phpcs/Exponential/Sniffs/TypeDeclarations/NoTypeDeclarationsSniff.php"/>

    <!-- PHP 8.1 is the oldest supported version: no syntax or functions of later
         versions (readonly classes, typed constants, json_validate(), ...), and no
         functions later versions removed or deprecate. PHPCompatibility comes with
         the development tools (composer.dev.json). -->
    <config name="testVersion" value="8.1-"/>
    <rule ref="PHPCompatibility"/>
</ruleset>
